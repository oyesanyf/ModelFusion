+	// TeamPresetManager Tests
+	// ═══════════════════════════════════════════════════════════════════
+	suite('TeamPresetManager', () => {
+		test('initializes with 4 built-in presets', () => {
+			const manager = new TeamPresetManager();
+			const presets = manager.getPresets();
+			assert.strictEqual(presets.length, 4);
+
+			const ids = presets.map(p => p.id);
+			assert.ok(ids.includes('architect_worker_swarm'));
+			assert.ok(ids.includes('avo_optimizer'));
+			assert.ok(ids.includes('local_sandbox'));
+			assert.ok(ids.includes('security_auditor'));
+		});
+
+		test('default active preset is architect_worker_swarm with 4 agents', () => {
+			const manager = new TeamPresetManager();
+			const active = manager.getActivePreset();
+			assert.strictEqual(active.id, 'architect_worker_swarm');
+			assert.strictEqual(active.defaultMode, 'swarm');
+
+			const agents = manager.getAgents();
+			assert.strictEqual(agents.length, 4);
+
+			const lead = manager.getAgent('agent_lead_architect');
+			assert.ok(lead);
+			assert.strictEqual(lead?.role, 'lead_architect');
+			assert.strictEqual(lead?.model, 'gemini-3.1-pro');
+		});
+
+		test('switches to AVO Optimizer preset', () => {
+			const manager = new TeamPresetManager();
+			const preset = manager.applyPreset('avo_optimizer');
+			assert.strictEqual(preset.id, 'avo_optimizer');
+			assert.strictEqual(manager.getActivePreset().id, 'avo_optimizer');
+
+			const agents = manager.getAgents();
+			assert.strictEqual(agents.length, 3);
+
+			const avoAgent = manager.getAgent('agent_avo_mutation_lead');
+			assert.ok(avoAgent);
+			assert.strictEqual(avoAgent?.role, 'avo_agent');
+		});
+
+		test('updates agent status and token counters', () => {
+			const manager = new TeamPresetManager();
+			manager.updateAgentStatus('agent_lead_architect', 'busy', 'Decomposing AST refactor plan', 1250);
+
+			const lead = manager.getAgent('agent_lead_architect');
+			assert.strictEqual(lead?.status, 'busy');
+			assert.strictEqual(lead?.currentTask, 'Decomposing AST refactor plan');
+			assert.strictEqual(lead?.tokensConsumed, 1250);
+		});
+
+		test('registers and applies custom preset', () => {
+			const manager = new TeamPresetManager();
+			manager.registerCustomPreset({
+				id: 'custom_bench_swarm',
+				name: 'Custom Bench Swarm',
+				description: 'Custom benchmark team',
+				defaultMode: 'swarm',
+				icon: 'rocket',
+				metadata: {},
+				agents: [
+					{
+						id: 'custom_agent_1',
+						name: 'Specialist',
+						role: 'worker',
+						model: 'gemini-3.7-flash',
+						temperature: 0.2,
+						maxTokens: 4096,
+						toolsEnabled: ['view_file'],
+						status: 'idle',
+						tokensConsumed: 0
+					}
+				]
+			});
+
+			const applied = manager.applyPreset('custom_bench_swarm');
+			assert.strictEqual(applied.id, 'custom_bench_swarm');
+			assert.strictEqual(manager.getAgents().length, 1);
+		});
+	});
+
+	// ═══════════════════════════════════════════════════════════════════
+	// EvolutionStateManager Tests
+	// ═══════════════════════════════════════════════════════════════════
+	suite('EvolutionStateManager', () => {
+		test('initializes with clean idle state', () => {
+			const stateManager = new EvolutionStateManager();
+			const runState = stateManager.getRunState();
+			assert.strictEqual(runState.status, 'idle');
+			assert.strictEqual(runState.currentIteration, 0);
+			assert.strictEqual(runState.bestFitness, 0);
+			assert.strictEqual(stateManager.getMetricsHistory().length, 0);
+			assert.strictEqual(stateManager.getCandidates().length, 0);
+		});
+
+		test('starts, pauses, resumes, and stops run', () => {
+			const stateManager = new EvolutionStateManager();
+			const runId = stateManager.startRun({
+				targetDir: 'src/lib',
+				iterations: 30,
+				mode: 'openevolve'
+			});
+
+			assert.ok(runId.startsWith('run_'));
+			let state = stateManager.getRunState();
+			assert.strictEqual(state.status, 'running');
+			assert.strictEqual(state.targetDir, 'src/lib');
+			assert.strictEqual(state.maxIterations, 30);
+
+			stateManager.pauseRun();
+			state = stateManager.getRunState();
+			assert.strictEqual(state.status, 'paused');
+
+			stateManager.resumeRun();
+			state = stateManager.getRunState();
+			assert.strictEqual(state.status, 'running');
+
+			stateManager.stopRun();
+			state = stateManager.getRunState();
+			assert.strictEqual(state.status, 'stopped');
+			assert.ok(state.endTime && state.endTime > 0);
+		});
+
+		test('records step progression and auto-completes on max iterations', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.startRun({
+				targetDir: 'src/',
+				iterations: 3,
+				mode: 'avo'
+			});
+
+			const pt1 = stateManager.recordStep({ generation: 1, fitness: 0.65, candidateId: 'c1' });
+			assert.strictEqual(pt1.fitness, 0.65);
+			assert.strictEqual(pt1.bestFitness, 0.65);
+			assert.strictEqual(stateManager.getRunState().bestFitness, 0.65);
+
+			const pt2 = stateManager.recordStep({ generation: 2, fitness: 0.55 });
+			assert.strictEqual(pt2.bestFitness, 0.65); // Retains historical best
+
+			const pt3 = stateManager.recordStep({ generation: 3, fitness: 0.88, candidateId: 'c3' });
+			assert.strictEqual(pt3.bestFitness, 0.88);
+
+			// Reached max iterations (3) -> should auto complete
+			assert.strictEqual(stateManager.getRunState().status, 'completed');
+			assert.strictEqual(stateManager.getMetricsHistory().length, 3);
+		});
+
+		test('adds and retrieves candidates and updates candidate status', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.addCandidate({
+				candidateId: 'cand_alpha_1',
+				generation: 1,
+				fitness: 0.84,
+				summary: 'Optimized loop vectorization',
+				diffSummary: '+15 -4 lines in math.ts',
+				filePath: 'src/math.ts',
+				candidateContent: 'export function compute() { return 42; }',
+				timestamp: Date.now(),
+				status: 'evaluated'
+			});
+
+			const cand = stateManager.getCandidate('cand_alpha_1');
+			assert.ok(cand);
+			assert.strictEqual(cand?.fitness, 0.84);
+			assert.strictEqual(cand?.status, 'evaluated');
+
+			stateManager.updateCandidateStatus('cand_alpha_1', 'applied');
+			const updated = stateManager.getCandidate('cand_alpha_1');
+			assert.strictEqual(updated?.status, 'applied');
+		});
+
+		test('adds and retrieves agent thoughts', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.addThought({
+				agentId: 'agent_lead_architect',
+				role: 'lead_architect',
+				thought: 'Analyzed AST complexity, dispatching worker alpha.',
+				state: 'active',
+				level: 'thought'
+			});
+
+			const thoughts = stateManager.getThoughts();
+			assert.ok(thoughts.length >= 1);
+			const lastThought = thoughts[thoughts.length - 1];
+			assert.strictEqual(lastThought.role, 'lead_architect');
+			assert.strictEqual(lastThought.level, 'thought');
+		});
+
+		test('updates backend statistics and resets state', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.updateBackendStats({
+				connected: true,
+				latencyMs: 6,
+				memoryUsageMb: 112.4,
+				mcpServerStatus: 'online'
+			});
+
+			const stats = stateManager.getBackendStats();
+			assert.strictEqual(stats.connected, true);
+			assert.strictEqual(stats.latencyMs, 6);
+			assert.strictEqual(stats.mcpServerStatus, 'online');
+
+			stateManager.resetState();
+			assert.strictEqual(stateManager.getRunState().status, 'idle');
+			assert.strictEqual(stateManager.getMetricsHistory().length, 0);
+			assert.strictEqual(stateManager.getCandidates().length, 0);
+		});
+	});
+
+	// ═══════════════════════════════════════════════════════════════════
+	// AsyncRingBuffer Tests
+	// ═══════════════════════════════════════════════════════════════════
+	suite('AsyncRingBuffer', () => {
+		test('maintains FIFO order during enqueue and drain', () => {
+			const ring = new AsyncRingBuffer<string>(8);
+			assert.strictEqual(ring.size, 0);
+			assert.strictEqual(ring.capacity, 8);
+
+			ring.push('event_1');
+			ring.push('event_2');
+			ring.push('event_3');
+
+			assert.strictEqual(ring.size, 3);
+			const drained = ring.drainAll();
+			assert.deepStrictEqual(drained, ['event_1', 'event_2', 'event_3']);
+			assert.strictEqual(ring.size, 0);
+		});
+
+		test('handles buffer overflow by overwriting oldest and tracking droppedCount', () => {
+			const ring = new AsyncRingBuffer<number>(4);
+			ring.push(1);
+			ring.push(2);
+			ring.push(3);
+			ring.push(4);
+			assert.strictEqual(ring.size, 4);
+			assert.strictEqual(ring.droppedCount, 0);
+
+			// Push 5th and 6th items (overwrites 1 and 2)
+			const res5 = ring.push(5);
+			const res6 = ring.push(6);
+			assert.strictEqual(res5, false); // indicated dropped
+			assert.strictEqual(res6, false);
+			assert.strictEqual(ring.droppedCount, 2);
+			assert.strictEqual(ring.size, 4);
+
+			const drained = ring.drainAll();
+			assert.deepStrictEqual(drained, [3, 4, 5, 6]);
+			assert.strictEqual(ring.size, 0);
+		});
+	});
+});
