@@ -0,0 +1,192 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+import { IExtensionContribution } from '../common/contributions';
+import { Disposable } from '../../util/vs/base/common/lifecycle';
+import { IVSCodeExtensionContext } from '../../platform/extContext/common/extensionContext';
+import { ILogService } from '../../platform/log/common/logService';
+import { IInstantiationService } from '../../util/vs/platform/instantiation/common/instantiation';
+import { EvolutionStateManager } from './evolutionStateManager';
+import { TeamPresetManager } from './teamPresetManager';
+import { EventStreamService } from './eventStreamService';
+import { DashboardViewProvider } from './dashboardViewProvider';
+import { OpenEvolveContentProvider } from './candidateContentProvider';
+import { CandidateApplier } from './candidateApplier';
+
+export class DashboardContribution extends Disposable implements IExtensionContribution {
+	public readonly id = 'hugos-dashboard-contribution';
+
+	private readonly _stateManager: EvolutionStateManager;
+	private readonly _presetManager: TeamPresetManager;
+	private readonly _eventStreamService: EventStreamService;
+	private readonly _contentProvider: OpenEvolveContentProvider;
+	private readonly _candidateApplier: CandidateApplier;
+	private readonly _viewProvider: DashboardViewProvider;
+
+	constructor(
+		@IVSCodeExtensionContext private readonly _extensionContext: IVSCodeExtensionContext,
+		@ILogService private readonly _logService: ILogService,
+		@IInstantiationService private readonly _instantiationService: IInstantiationService
+	) {
+		super();
+
+		this._stateManager = this._register(new EvolutionStateManager());
+		this._presetManager = this._register(new TeamPresetManager());
+		this._eventStreamService = this._register(
+			this._instantiationService.createInstance(
+				EventStreamService,
+				this._stateManager,
+				this._presetManager
+			)
+		);
+
+		this._contentProvider = this._register(new OpenEvolveContentProvider(this._stateManager));
+		this._register(
+			vscode.workspace.registerTextDocumentContentProvider(
+				OpenEvolveContentProvider.scheme,
+				this._contentProvider
+			)
+		);
+
+		this._candidateApplier = this._register(new CandidateApplier(this._stateManager));
+
+		this._viewProvider = this._register(
+			new DashboardViewProvider(
+				this._extensionContext.extensionUri,
+				this._stateManager,
+				this._presetManager,
+				this._eventStreamService,
+				this._logService
+			)
+		);
+
+		this._registerWebviewProvider();
+		this._registerCommands();
+
+		this._eventStreamService.start();
+		this._logService.info('HugOS Studio Dashboard contribution initialized successfully.');
+	}
+
+	public get stateManager(): EvolutionStateManager {
+		return this._stateManager;
+	}
+
+	public get presetManager(): TeamPresetManager {
+		return this._presetManager;
+	}
+
+	public get eventStreamService(): EventStreamService {
+		return this._eventStreamService;
+	}
+
+	public get contentProvider(): OpenEvolveContentProvider {
+		return this._contentProvider;
+	}
+
+	public get candidateApplier(): CandidateApplier {
+		return this._candidateApplier;
+	}
+
+	public get viewProvider(): DashboardViewProvider {
+		return this._viewProvider;
+	}
+
+	private _registerWebviewProvider(): void {
+		this._register(
+			vscode.window.registerWebviewViewProvider(
+				DashboardViewProvider.viewType,
+				this._viewProvider,
+				{
+					webviewOptions: {
+						retainContextWhenHidden: true
+					}
+				}
+			)
+		);
+	}
+
+	private _registerCommands(): void {
+		this._register(
+			vscode.commands.registerCommand('hugos.dashboard.open', () => {
+				this._viewProvider.openInPanel();
+			})
+		);
+
+		this._register(
+			vscode.commands.registerCommand('hugos.dashboard.refresh', () => {
+				this._viewProvider.refresh();
+			})
+		);
+
+		this._register(
+			vscode.commands.registerCommand('hugos.dashboard.resetState', () => {
+				this._viewProvider.resetState();
+			})
+		);
+
+		// Candidate diff and patch application commands
+		this._register(
+			vscode.commands.registerCommand(
+				'hugos.candidate.openDiff',
+				async (candidateId: string, filePath: string, originalContent?: string, candidateContent?: string) => {
+					return await this._candidateApplier.openCandidateDiff(candidateId, filePath, originalContent, candidateContent);
+				}
+			)
+		);
+
+		this._register(
+			vscode.commands.registerCommand(
+				'hugos.candidate.applyPatch',
+				async (candidateId: string, filePath: string, candidateContent?: string) => {
+					return await this._candidateApplier.applyCandidatePatch(candidateId, filePath, candidateContent);
+				}
+			)
+		);
+
+		this._register(
+			vscode.commands.registerCommand(
+				'hugos.candidate.rollbackPatch',
+				async (filePath: string) => {
+					return await this._candidateApplier.rollbackPatch(filePath);
+				}
+			)
+		);
+
+		// Evolution state commands
+		this._register(
+			vscode.commands.registerCommand(
+				'hugos.evolution.launch',
+				(config: { targetDir?: string; targetFile?: string; iterations?: number; mode?: any }) => {
+					return this._stateManager.startRun(config || { targetDir: 'src/', iterations: 20, mode: 'openevolve' });
+				}
+			)
+		);
+
+		this._register(
+			vscode.commands.registerCommand('hugos.evolution.pause', () => {
+				this._stateManager.pauseRun();
+			})
+		);
+
+		this._register(
+			vscode.commands.registerCommand('hugos.evolution.resume', () => {
+				this._stateManager.resumeRun();
+			})
+		);
+
+		this._register(
+			vscode.commands.registerCommand('hugos.evolution.stop', () => {
+				this._stateManager.stopRun();
+			})
+		);
+
+		this._register(
+			vscode.commands.registerCommand('hugos.preset.apply', (presetId: string) => {
+				return this._presetManager.applyPreset(presetId);
+			})
+		);
+	}
+}
