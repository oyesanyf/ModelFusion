+					toolsEnabled: ['find_by_name', 'view_file', 'run_command'],
+					status: 'idle',
+					tokensConsumed: 0,
+					parentAgentId: 'agent_local_lead',
+					avatarIcon: 'check-all'
+				}
+			]
+		};
+
+		// Preset 4: Security Auditor
+		const securityAuditor: TeamPresetConfig = {
+			id: 'security_auditor',
+			name: 'Security & Integrity Auditor',
+			description: 'Adversarial vulnerability detection, deep AST taint analysis, and strict compliance policy verification.',
+			defaultMode: 'swarm',
+			icon: 'lock',
+			metadata: {
+				recommendedTasks: ['Vulnerability Scan', 'Secret Leak Detection', 'Forensic Audit'],
+				threatModels: ['OWASP Top 10', 'CWE-SANS Top 25']
+			},
+			agents: [
+				{
+					id: 'agent_vuln_hunter',
+					name: 'Vulnerability Hunter',
+					role: 'security_auditor',
