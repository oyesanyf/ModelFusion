+                this.configuration.set(fullKey, value);
+                return true;
+            }
+        };
+    }
+}
+
+/**
+ * In-Memory Non-Blocking Ring Buffer Implementation for Testing & Contract Verification
+ */
+export class NonBlockingRingBuffer {
+    constructor(capacity = 500, frameRateHz = 60) {
+        this.capacity = capacity;
+        this.frameIntervalMs = 1000 / frameRateHz;
+        this.buffer = new Array(capacity);
+        this.head = 0;
+        this.tail = 0;
+        this.size = 0;
+        this.totalPushed = 0;
+        this.totalDropped = 0;
+        this.subscribers = new Set();
+        this.timer = null;
+        this._isDisposed = false;
+    }
+
+    push(item) {
+        if (this._isDisposed) return false;
+        if (this.size === this.capacity) {
+            // Drop oldest
+            this.tail = (this.tail + 1) % this.capacity;
+            this.size--;
+            this.totalDropped++;
+        }
+        this.buffer[this.head] = { item, timestamp: Date.now() };
+        this.head = (this.head + 1) % this.capacity;
+        this.size++;
+        this.totalPushed++;
+        this._scheduleFlush();
+        return true;
+    }
+
+    _scheduleFlush() {
+        if (this.timer || this.size === 0 || this._isDisposed) return;
+        this.timer = setTimeout(() => {
+            this.timer = null;
+            this.flush();
+        }, this.frameIntervalMs);
+    }
+
+    flush() {
+        if (this.size === 0) return [];
+        const batch = [];
+        while (this.size > 0) {
+            const entry = this.buffer[this.tail];
+            batch.push(entry.item);
+            this.buffer[this.tail] = null;
+            this.tail = (this.tail + 1) % this.capacity;
+            this.size--;
+        }
+        for (const sub of this.subscribers) {
+            try {
+                sub(batch);
+            } catch (err) {
+                // Ignore subscriber errors to preserve non-blocking behavior
+            }
+        }
+        return batch;
+    }
+
+    subscribe(callback) {
+        this.subscribers.add(callback);
+        return new Disposable(() => this.subscribers.delete(callback));
+    }
+
+    dispose() {
+        this._isDisposed = true;
+        if (this.timer) {
+            clearTimeout(this.timer);
+            this.timer = null;
+        }
+        this.subscribers.clear();
+        this.buffer.fill(null);
+        this.size = 0;
+    }
+}
+
+/**
+ * Evolution State Manager Implementation for Contract Testing
+ */
+export class EvolutionStateManager extends EventEmitter {
+    constructor() {
+        super();
+        this.state = 'idle'; // 'idle' | 'running' | 'paused' | 'completed' | 'stopped'
+        this.currentRunId = null;
+        this.currentStep = 0;
+        this.generation = 0;
+        this.bestFitness = 0.0;
+        this.metricsHistory = [];
+        this.candidates = new Map(); // candidateId -> { id, filePath, patch, candidateContent, originalContent, fitness, step }
+        this.activeAgents = new Map(); // agentId -> { id, role, state, currentThought, lastUpdated }
+        this.activePreset = 'architect_worker_swarm';
+        this.eventBuffer = new NonBlockingRingBuffer(500, 60);
+    }
+
+    launch(runConfig) {
+        if (this.state === 'running') {
+            throw new Error('Evolution is already running');
+        }
+        this.state = 'running';
+        this.currentRunId = runConfig.runId || `run_${Date.now()}`;
+        this.currentStep = 0;
+        this.generation = 0;
+        this.bestFitness = 0.0;
+        this.metricsHistory = [];
+        this.candidates.clear();
+        
+        const event = {
+            type: 'evolutionState',
+            state: this.state,
+            runId: this.currentRunId,
+            config: runConfig
+        };
+        this.eventBuffer.push(event);
+        this.emit('stateChange', this.state, event);
+        return this.currentRunId;
+    }
+
+    pause() {
+        if (this.state !== 'running') {
+            throw new Error(`Cannot pause evolution in state ${this.state}`);
+        }
+        this.state = 'paused';
+        const event = { type: 'evolutionState', state: this.state, runId: this.currentRunId };
+        this.eventBuffer.push(event);
+        this.emit('stateChange', this.state, event);
+    }
+
+    resume() {
+        if (this.state !== 'paused') {
+            throw new Error(`Cannot resume evolution in state ${this.state}`);
+        }
+        this.state = 'running';
+        const event = { type: 'evolutionState', state: this.state, runId: this.currentRunId };
+        this.eventBuffer.push(event);
+        this.emit('stateChange', this.state, event);
+    }
+
+    stop() {
+        if (this.state === 'idle' || this.state === 'stopped') {
+            return;
+        }
+        this.state = 'stopped';
+        const event = { type: 'evolutionState', state: this.state, runId: this.currentRunId };
+        this.eventBuffer.push(event);
+        this.emit('stateChange', this.state, event);
+    }
+
+    recordStep(stepData) {
+        this.currentStep = stepData.step;
+        this.generation = stepData.generation || this.currentStep;
+        if (stepData.fitness > this.bestFitness) {
+            this.bestFitness = stepData.fitness;
+        }
+        this.metricsHistory.push({
+            step: this.currentStep,
+            generation: this.generation,
+            fitness: stepData.fitness,
+            bestFitness: this.bestFitness,
+            metrics: stepData.metrics || {},
+            timestamp: Date.now()
+        });
+
+        if (stepData.candidateId && stepData.candidateContent !== undefined) {
+            this.candidates.set(stepData.candidateId, {
+                id: stepData.candidateId,
+                filePath: stepData.filePath,
+                patch: stepData.patch || '',
+                candidateContent: stepData.candidateContent,
+                originalContent: stepData.originalContent || '',
+                fitness: stepData.fitness,
+                step: this.currentStep
+            });
+        }
+
+        const event = {
+            type: 'evolutionStep',
+            step: this.currentStep,
+            generation: this.generation,
+            fitness: stepData.fitness,
+            bestFitness: this.bestFitness,
+            metrics: stepData.metrics || {},
+            candidateId: stepData.candidateId,
+            summary: stepData.summary || ''
+        };
+        this.eventBuffer.push(event);
+        this.emit('step', event);
+    }
+
+    recordThought(agentId, role, thought, state = 'thinking') {
+        const agent = this.activeAgents.get(agentId) || { id: agentId, role, state: 'idle' };
+        agent.state = state;
+        agent.currentThought = thought;
+        agent.lastUpdated = Date.now();
+        this.activeAgents.set(agentId, agent);
+
+        const event = {
+            type: 'agentThoughtStream',
+            agentId,
+            role,
+            thought,
+            timestamp: Date.now(),
+            state
+        };
+        this.eventBuffer.push(event);
+        this.emit('thought', event);
+    }
+
+    setPreset(presetId, presetConfig) {
+        this.activePreset = presetId;
+        const event = {
+            type: 'teamStateUpdate',
+            activePreset: presetId,
+            presetConfig,
+            agents: Array.from(this.activeAgents.values())
+        };
+        this.eventBuffer.push(event);
+        this.emit('presetChange', presetId, event);
+    }
+
+    getCandidate(candidateId) {
+        return this.candidates.get(candidateId);
+    }
+
+    dispose() {
+        this.eventBuffer.dispose();
+        this.removeAllListeners();
+    }
+}
+
+/**
+ * Virtual Document Provider Implementation for Testing
+ */
+export class OpenEvolveContentProvider {
+    constructor(stateManager) {
+        this.stateManager = stateManager;
+        this._onDidChange = new EventEmitter();
+    }
+    get onDidChange() {
+        return (listener) => {
+            this._onDidChange.on('change', listener);
+            return new Disposable(() => this._onDidChange.off('change', listener));
+        };
+    }
+    provideTextDocumentContent(uri) {
+        // URI format: hugos-candidate://candidate/<candidateId>/<path>
+        const parts = uri.path.replace(/^\//, '').split('/');
+        const candidateId = parts[0];
+        if (!candidateId) {
+            return '// Error: Missing candidate ID';
+        }
+        const candidate = this.stateManager.getCandidate(candidateId);
+        if (!candidate) {
+            return `// Candidate ${candidateId} not found in active session`;
+        }
+        return candidate.candidateContent;
+    }
+    notifyCandidateUpdated(candidateId) {
+        const uri = Uri.parse(`hugos-candidate://candidate/${candidateId}/target.ts`);
+        this._onDidChange.emit('change', uri);
+    }
+}
+
+/**
+ * Candidate Applier and Workspace Edit Integration
+ */
+export class CandidateApplier {
+    constructor(vscodeEnv, stateManager) {
+        this.vscode = vscodeEnv;
+        this.stateManager = stateManager;
+        this.backupHistory = new Map(); // filePath -> originalContent
+    }
+
+    async openCandidateDiff(candidateId, filePath) {
+        const candidate = this.stateManager.getCandidate(candidateId);
+        if (!candidate) {
+            throw new Error(`Candidate ${candidateId} not found`);
+        }
+        const originalUri = Uri.file(filePath);
+        const candidateUri = Uri.parse(`hugos-candidate://candidate/${candidateId}/${filePath.split(/[/\\]/).pop()}`);
+        const title = `Candidate ${candidateId} ↔ Baseline (${filePath.split(/[/\\]/).pop()})`;
+        
+        await this.vscode.executeCommand('vscode.diff', originalUri, candidateUri, title, {
+            preview: false,
+            preserveFocus: true
+        });
+        return { originalUri, candidateUri, title };
+    }
+
+    async applyCandidatePatch(candidateId, filePath) {
+        const candidate = this.stateManager.getCandidate(candidateId);
+        if (!candidate) {
+            throw new Error(`Candidate ${candidateId} not found`);
+        }
+        const currentFile = this.vscode.workspaceFiles.get(filePath);
+        if (currentFile !== undefined) {
+            this.backupHistory.set(filePath, currentFile);
+        }
+
+        const edit = new WorkspaceEdit();
+        const fileUri = Uri.file(filePath);
+        edit.replace(fileUri, { start: 0, end: (currentFile || '').length }, candidate.candidateContent);
+        
+        const success = await this.vscode.applyEdit(edit);
+        if (success) {
+            this.vscode.workspaceFiles.set(filePath, candidate.candidateContent);
+        }
+        return success;
+    }
+
+    async rollbackPatch(filePath) {
+        if (!this.backupHistory.has(filePath)) {
+            throw new Error(`No backup found for ${filePath}`);
+        }
+        const original = this.backupHistory.get(filePath);
+        const edit = new WorkspaceEdit();
+        const fileUri = Uri.file(filePath);
+        edit.replace(fileUri, { start: 0, end: (this.vscode.workspaceFiles.get(filePath) || '').length }, original);
+        const success = await this.vscode.applyEdit(edit);
+        if (success) {
+            this.vscode.workspaceFiles.set(filePath, original);
+            this.backupHistory.delete(filePath);
+        }
+        return success;
+    }
+}
