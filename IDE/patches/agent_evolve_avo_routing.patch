+﻿// tier4_workloads.test.mjs - Tier 4: Real-World Application Workloads (6 Scenarios)
+import { describe, it, beforeEach, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    MockVSCodeEnvironment,
+    MockWebviewView,
+    MockWebview,
+    NonBlockingRingBuffer,
+    EvolutionStateManager,
+    OpenEvolveContentProvider,
+    CandidateApplier,
+    Uri,
+    WorkspaceEdit
+} from './testHarness.mjs';
+
+describe('Tier 4: Real-World Application Workloads', () => {
+    let vscode;
+    let stateManager;
+    let contentProvider;
+    let applier;
+
+    beforeEach(() => {
+        vscode = new MockVSCodeEnvironment();
+        stateManager = new EvolutionStateManager();
+        contentProvider = new OpenEvolveContentProvider(stateManager);
+        applier = new CandidateApplier(vscode, stateManager);
+    });
+
+    afterEach(() => {
+        stateManager.dispose();
+    });
+
+    it('SCENARIO-01: Full Evolutionary Optimization Run with Multi-Island Migration, Candidate Diff Inspection, and Workspace Patch Application', async () => {
+        // Step 1: Initialize workspace target file
+        const targetPath = 'src/attention_metal.c';
+        const initialCode = '// Naive unvectorized Metal shader\nvoid compute() {}';
+        vscode.workspaceFiles.set(targetPath, initialCode);
+
+        // Step 2: Configure and Launch Evolution
+        stateManager.setPreset('avo_optimizer', { numIslands: 4, migrationInterval: 5 });
+        const runId = stateManager.launch({
+            runId: 'avo_run_full_metal',
+            targetFile: targetPath,
+            evaluatorPath: 'eval/eval_metal.py',
+            iterations: 10
+        });
+        assert.equal(stateManager.state, 'running');
+
+        // Step 3: Simulate 5 Evolutionary Iterations across Islands
+        const candidates = [
+            { step: 1, fitness: 0.65, id: 'cand_1', code: '// Loop unrolling\nvoid compute() {}' },
+            { step: 2, fitness: 0.78, id: 'cand_2', code: '// SIMD tile fetch\nvoid compute() {}' },
+            { step: 3, fitness: 0.85, id: 'cand_3', code: '// Shared memory cache\nvoid compute() {}' },
+            { step: 4, fitness: 0.82, id: 'cand_4', code: '// Subgroup barrier\nvoid compute() {}' },
+            { step: 5, fitness: 0.98, id: 'cand_5', code: '// Peak vectorized Metal kernel\nvoid compute() {}' }
+        ];
+
+        for (const c of candidates) {
+            stateManager.recordThought('avo-runner', 'AVO Agent', `Evaluating iteration ${c.step} on Island ${(c.step % 4) + 1}`);
+            stateManager.recordStep({
+                step: c.step,
+                generation: c.step,
+                fitness: c.fitness,
+                metrics: { latency_us: 1000 - (c.fitness * 800), throughput_gflops: c.fitness * 2500 },
+                candidateId: c.id,
+                filePath: targetPath,
+                candidateContent: c.code,
+                summary: `Improvement step ${c.step}`
+            });
+        }
+
+        assert.equal(stateManager.bestFitness, 0.98);
+
+        // Step 4: Inspect Side-by-Side Diff of Best Candidate
+        const diffInfo = await applier.openCandidateDiff('cand_5', targetPath);
+        assert.equal(diffInfo.candidateUri.toString(), 'hugos-candidate://candidate/cand_5/attention_metal.c');
+        assert.equal(contentProvider.provideTextDocumentContent(diffInfo.candidateUri), '// Peak vectorized Metal kernel\nvoid compute() {}');
+
+        // Step 5: One-Click Apply to Workspace
+        const applied = await applier.applyCandidatePatch('cand_5', targetPath);
+        assert.equal(applied, true);
+        assert.equal(vscode.workspaceFiles.get(targetPath), '// Peak vectorized Metal kernel\nvoid compute() {}');
+
+        // Step 6: Gracefully Stop Run
+        stateManager.stop();
+        assert.equal(stateManager.state, 'stopped');
+    });
+
+    it('SCENARIO-02: Multi-Agent Swarm Dynamic Reconfiguration, Hierarchical Task Delegation, and Live Glassmorphism Thought Streaming', () => {
+        // Step 1: Load Swarm Configuration
+        stateManager.setPreset('architect_worker_swarm');
+        assert.equal(stateManager.activePreset, 'architect_worker_swarm');
+
+        // Step 2: Lead Architect Decomposes Refactoring Task
+        stateManager.recordThought('lead-pro', 'Lead Architect', 'Analyzing memory footprint of model cache', 'thinking');
+        
+        // Step 3: Spawning Worker Subagents
+        stateManager.recordThought('worker-flash-1', 'Worker Subagent', 'Extracting tensor allocations', 'executing');
+        stateManager.recordThought('worker-flash-2', 'Worker Subagent', 'Profiling cache miss rate', 'executing');
+        stateManager.recordThought('evaluator-pro', 'Evaluator', 'Benchmarking AST integrity', 'evaluating');
+
+        assert.equal(stateManager.activeAgents.size, 4);
+
+        // Step 4: Stream Tool Logs
+        stateManager.recordThought('worker-flash-1', 'Worker Subagent', 'Ran test: <bash>cargo test --package cache</bash>', 'tool_use');
+        stateManager.recordThought('worker-flash-2', 'Worker Subagent', 'Applied edit: <replace path="src/cache.rs">LRU replacement</replace>', 'tool_use');
+
+        // Step 5: Verify Ring Buffer Dispatches all Frames Cleanly
+        const flushed = stateManager.eventBuffer.flush();
+        assert.ok(flushed.length >= 6);
+        assert.ok(flushed.some(f => f.thought && f.thought.includes('<bash>')));
+    });
+
+    it('SCENARIO-03: Chat Panel Command Orchestration (/evolve, @agent, /stats) with Real-Time Bidirectional Dashboard Synchronization', () => {
+        const webview = new MockWebview();
+        stateManager.eventBuffer.subscribe(batch => batch.forEach(m => webview.postMessage(m)));
+
+        // User types /stats in chat
+        stateManager.recordThought('chat-bot', 'ModelFusionLMProvider', 'Intercepted /stats in 0.8ms');
+        
+        // User triggers /evolve
+        const runId = stateManager.launch({ targetFile: 'src/transformer.py', iterations: 20 });
+        stateManager.recordStep({ step: 1, fitness: 0.75, candidateId: 'trans_c1' });
+
+        stateManager.eventBuffer.flush();
+
+        // Verify Webview received synchronous event stream
+        const receivedTypes = webview._messagesSent.map(m => m.type);
+        assert.ok(receivedTypes.includes('agentThoughtStream'));
+        assert.ok(receivedTypes.includes('evolutionState'));
+        assert.ok(receivedTypes.includes('evolutionStep'));
+    });
+
+    it('SCENARIO-04: High-Frequency Event Storm (10,000 events/sec) with Non-Blocking 60fps Ring Buffer Dispatch and Smooth UI Rendering', () => {
+        const buffer = new NonBlockingRingBuffer(500, 60);
+        let batchesReceived = 0;
+        let totalItemsReceived = 0;
+
+        buffer.subscribe((batch) => {
+            batchesReceived++;
+            totalItemsReceived += batch.length;
+        });
+
+        // Simulate massive storm of 5,000 events
+        for (let i = 0; i < 5000; i++) {
+            buffer.push({ seq: i, token: 'chunk', ts: Date.now() });
+        }
+
+        // Buffer bounded at 500
+        assert.equal(buffer.size, 500);
+        assert.equal(buffer.totalDropped, 4500);
+
+        const flushed = buffer.flush();
+        assert.equal(flushed.length, 500);
+        assert.equal(totalItemsReceived, 500);
+        buffer.dispose();
+    });
+
+    it('SCENARIO-05: Candidate Patch Conflict Detection, Three-Way Merge Inspection, and Atomic Workspace Rollback', async () => {
+        const filePath = 'src/conflict_scenario.ts';
+        vscode.workspaceFiles.set(filePath, 'version 1 (original)');
+
+        stateManager.recordStep({
+            step: 1,
+            fitness: 0.91,
+            candidateId: 'cand_merge_1',
+            filePath,
+            candidateContent: 'version 2 (evolved patch)'
+        });
+
+        // Apply patch
+        await applier.applyCandidatePatch('cand_merge_1', filePath);
+        assert.equal(vscode.workspaceFiles.get(filePath), 'version 2 (evolved patch)');
+
+        // Unit test suite fails on workspace -> trigger rollback
+        const rolledBack = await applier.rollbackPatch(filePath);
+        assert.equal(rolledBack, true);
+        assert.equal(vscode.workspaceFiles.get(filePath), 'version 1 (original)');
+    });
+
+    it('SCENARIO-06: Autonomous AVO Search Stagnation Recovery via Supervisor Meta-Agent Intervention and Lineage Forking', () => {
+        stateManager.setPreset('avo_optimizer', { stagnationWindow: 3 });
+        stateManager.launch({ targetFile: 'src/stagnant_kernel.cu' });
+
+        // 3 steps without fitness improvement
+        stateManager.recordStep({ step: 1, fitness: 0.70, candidateId: 's1' });
+        stateManager.recordStep({ step: 2, fitness: 0.68, candidateId: 's2' });
+        stateManager.recordStep({ step: 3, fitness: 0.69, candidateId: 's3' });
+
+        // Stagnation detected -> Supervisor intervention
+        stateManager.recordThought('supervisor-meta', 'Supervisor Agent', 'Stagnation detected (3 steps). Injecting architectural shift note: use warp shuffle intrinsics.');
+
+        // Step 4 post-intervention achieves breakthrough
+        stateManager.recordStep({
+            step: 4,
+            fitness: 0.96,
+            candidateId: 's4_breakthrough',
+            metrics: { warp_efficiency: 0.99 },
+            summary: 'Warp shuffle reduction applied'
+        });
+
+        assert.equal(stateManager.bestFitness, 0.96);
+        assert.equal(stateManager.currentStep, 4);
+    });
+});
