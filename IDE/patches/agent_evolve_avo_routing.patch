+					temperature: 0.2,
+					maxTokens: 8192,
+					toolsEnabled: ['taint_analysis', 'grep_search', 'ast_inspect', 'audit_report'],
+					status: 'idle',
+					tokensConsumed: 0,
+					avatarIcon: 'shield'
+				},
+				{
+					id: 'agent_diff_forensic',
+					name: 'Forensic Diff Inspector',
+					role: 'worker',
+					model: 'gemini-3.7-flash',
+					temperature: 0.1,
+					maxTokens: 4096,
+					toolsEnabled: ['view_file', 'git_log_inspect', 'patch_verify'],
+					status: 'idle',
+					tokensConsumed: 0,
+					parentAgentId: 'agent_vuln_hunter',
+					avatarIcon: 'search'
+				},
+				{
+					id: 'agent_policy_verifier',
+					name: 'Policy & Secret Verifier',
+					role: 'evaluator',
+					model: 'gemini-3.7-flash',
+					temperature: 0.1,
+					maxTokens: 2048,
+					toolsEnabled: ['secret_scan', 'run_command'],
+					status: 'idle',
+					tokensConsumed: 0,
+					parentAgentId: 'agent_vuln_hunter',
+					avatarIcon: 'checklist'
+				}
+			]
+		};
+
+		this._presets.set(architectWorkerSwarm.id, architectWorkerSwarm);
+		this._presets.set(avoOptimizer.id, avoOptimizer);
+		this._presets.set(localSandbox.id, localSandbox);
+		this._presets.set(securityAuditor.id, securityAuditor);
+	}
+
+	public getPresets(): TeamPresetConfig[] {
+		return Array.from(this._presets.values());
+	}
+
+	public getPreset(id: string): TeamPresetConfig | undefined {
+		return this._presets.get(id);
+	}
+
+	public getActivePreset(): TeamPresetConfig {
+		const preset = this._presets.get(this._activePresetId);
+		if (!preset) {
+			return this._presets.get('architect_worker_swarm')!;
+		}
+		return preset;
+	}
+
+	public applyPreset(presetId: string): TeamPresetConfig {
+		const preset = this._presets.get(presetId);
+		if (!preset) {
+			throw new Error(`Team Preset with id "${presetId}" does not exist.`);
+		}
+
+		this._activePresetId = presetId;
+		this._activeAgents.clear();
+
+		for (const agent of preset.agents) {
+			this._activeAgents.set(agent.id, { ...agent });
+		}
+
+		this._onPresetChanged.fire(preset);
+		this._onAgentsUpdated.fire(this.getAgents());
+		return preset;
+	}
+
+	public getAgents(): AgentConfig[] {
+		return Array.from(this._activeAgents.values());
+	}
+
+	public getAgent(id: string): AgentConfig | undefined {
+		return this._activeAgents.get(id);
+	}
+
+	public updateAgentStatus(agentId: string, status: AgentStatus, currentTask?: string, tokensDelta: number = 0): void {
+		const agent = this._activeAgents.get(agentId);
+		if (agent) {
+			agent.status = status;
+			if (currentTask !== undefined) {
+				agent.currentTask = currentTask;
+			}
+			if (tokensDelta > 0) {
+				agent.tokensConsumed += tokensDelta;
+			}
+			this._onAgentsUpdated.fire(this.getAgents());
+		}
+	}
+
+	public registerCustomPreset(preset: TeamPresetConfig): void {
+		this._presets.set(preset.id, preset);
+	}
+}
