+/**
+ * Mock Disposable
+ */
+export class Disposable {
+    constructor(callOnDispose) {
+        this._callOnDispose = callOnDispose;
+        this._isDisposed = false;
+    }
+    dispose() {
+        if (!this._isDisposed) {
+            this._isDisposed = true;
+            if (this._callOnDispose) {
+                this._callOnDispose();
+            }
+        }
+    }
+    get isDisposed() {
+        return this._isDisposed;
+    }
+}
