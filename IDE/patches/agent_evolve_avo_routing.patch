+ *--------------------------------------------------------------------------------------------*/
+
+import { describe, it, expect, beforeEach, afterEach } from 'vitest';
+import { URI } from '../../../util/vs/base/common/uri';
+import { EvolutionStateManager } from '../evolutionStateManager';
+import { TeamPresetManager } from '../teamPresetManager';
+import { OpenEvolveContentProvider, CANDIDATE_SCHEME } from '../candidateContentProvider';
+import { CandidateApplier } from '../candidateApplier';
+
+describe('Dashboard M3, M4 & M5 Vitest Specification', () => {
+	let stateManager: EvolutionStateManager;
+	let presetManager: TeamPresetManager;
+	let contentProvider: OpenEvolveContentProvider;
+	let mockVscodeEnv: {
+		commandExecutions: Array<{ command: string; args: any[] }>;
+		workspaceFiles: Map<string, string>;
+		executeCommand: (cmd: string, ...args: any[]) => Promise<boolean>;
+		applyEdit: (edit: any) => Promise<boolean>;
+	};
+	let applier: CandidateApplier;
+
+	beforeEach(() => {
+		stateManager = new EvolutionStateManager();
+		presetManager = new TeamPresetManager();
+		contentProvider = new OpenEvolveContentProvider(stateManager);
+
+		mockVscodeEnv = {
+			commandExecutions: [],
+			workspaceFiles: new Map<string, string>(),
+			executeCommand: async (cmd: string, ...args: any[]) => {
+				mockVscodeEnv.commandExecutions.push({ command: cmd, args });
+				return true;
+			},
+			applyEdit: async (edit: any) => {
+				if (edit && edit.edits) {
+					for (const [uriStr, fileEdits] of edit.edits.entries()) {
+						const uri = URI.parse(uriStr);
+						let current = mockVscodeEnv.workspaceFiles.get(uri.fsPath) || '';
+						for (const item of fileEdits) {
+							current = item.newText;
+						}
+						mockVscodeEnv.workspaceFiles.set(uri.fsPath, current);
+					}
+				}
+				return true;
+			}
+		};
+
+		applier = new CandidateApplier(stateManager, mockVscodeEnv);
+	});
+
+	afterEach(() => {
+		stateManager.dispose();
+		presetManager.dispose();
+		contentProvider.dispose();
+		applier.dispose();
+	});
+
+	// ═══════════════════════════════════════════════════════════════════
+	// Milestone M4: Virtual Candidate Document Provider (F10)
+	// ═══════════════════════════════════════════════════════════════════
+	describe('Virtual Candidate Document Provider (OpenEvolveContentProvider)', () => {
+		it('registers with scheme hugos-candidate', () => {
+			expect(OpenEvolveContentProvider.scheme).toBe('hugos-candidate');
+			expect(CANDIDATE_SCHEME).toBe('hugos-candidate');
+		});
+
+		it('provides candidate code content from active state manager', () => {
+			stateManager.addCandidate({
+				candidateId: 'cand_test_01',
+				generation: 2,
+				fitness: 0.92,
+				summary: 'Vectorized SIMD loop',
+				diffSummary: '+10 -2 lines',
+				filePath: 'src/math.ts',
+				candidateContent: 'export function compute() { return "vectorized"; }',
+				timestamp: Date.now(),
+				status: 'evaluated'
+			});
+
+			const uri = URI.parse('hugos-candidate://candidate/cand_test_01/math.ts') as any;
+			const content = contentProvider.provideTextDocumentContent(uri);
+			expect(content).toBe('export function compute() { return "vectorized"; }');
+		});
+
+		it('returns informative message when candidate ID is not found', () => {
+			const uri = URI.parse('hugos-candidate://candidate/non_existent_id/math.ts') as any;
+			const content = contentProvider.provideTextDocumentContent(uri);
+			expect(content).toContain('not found in active session');
+		});
+
+		it('handles malformed URI or empty candidate ID safely', () => {
+			const uri = URI.parse('hugos-candidate://candidate//') as any;
+			const content = contentProvider.provideTextDocumentContent(uri);
+			expect(content).toContain('Error: Missing candidate ID');
+		});
+
+		it('sanitizes directory traversal attempts', () => {
+			const uri = URI.parse('hugos-candidate://candidate/../../etc/passwd') as any;
+			const content = contentProvider.provideTextDocumentContent(uri);
+			expect(content).toContain('not found in active session');
+		});
+
+		it('fires onDidChange event when notifyCandidateUpdated is invoked', () => {
+			let updatedUri: any = null;
+			contentProvider.onDidChange(uri => {
+				updatedUri = uri;
+			});
+
+			contentProvider.notifyCandidateUpdated('cand_test_01', 'src/math.ts');
+			expect(updatedUri).not.toBeNull();
+			expect(updatedUri?.scheme).toBe('hugos-candidate');
+			expect(updatedUri?.path).toContain('cand_test_01');
+		});
+	});
+
+	// ═══════════════════════════════════════════════════════════════════
+	// Milestone M4: Side-by-Side Diff Viewer & Patch Applier (F11, F12)
+	// ═══════════════════════════════════════════════════════════════════
+	describe('CandidateApplier (Side-by-Side Diff & Workspace Patch Apply)', () => {
+		it('launches native vscode.diff with baseline and candidate URIs', async () => {
+			stateManager.addCandidate({
+				candidateId: 'cand_diff_01',
+				generation: 1,
+				fitness: 0.88,
+				summary: 'Optimized QuickSort',
+				diffSummary: '+12 -4 lines',
+				filePath: 'src/sort.ts',
+				candidateContent: 'export function quicksort() { return []; }',
+				timestamp: Date.now(),
+				status: 'evaluated'
+			});
+
+			const diffResult = await applier.openCandidateDiff('cand_diff_01', 'src/sort.ts');
+			expect(diffResult.candidateUri.scheme).toBe('hugos-candidate');
+			expect(diffResult.originalUri.scheme).toBe('file');
+			expect(diffResult.title).toBe('Candidate cand_diff_01 ↔ Baseline (sort.ts)');
+			expect(mockVscodeEnv.commandExecutions.length).toBe(1);
+			expect(mockVscodeEnv.commandExecutions[0].command).toBe('vscode.diff');
+		});
+
+		it('throws when opening diff for missing candidate without content', async () => {
+			await expect(applier.openCandidateDiff('missing_candidate', 'src/file.ts')).rejects.toThrow(
+				'Candidate missing_candidate not found'
+			);
+		});
+
+		it('applies candidate patch atomically and records backup snapshot', async () => {
+			mockVscodeEnv.workspaceFiles.set('src/algorithm.ts', 'function baseline() {}');
+			stateManager.addCandidate({
+				candidateId: 'cand_patch_01',
+				generation: 1,
+				fitness: 0.95,
+				summary: 'Fast algorithm',
+				diffSummary: '+5 -1 lines',
+				filePath: 'src/algorithm.ts',
+				candidateContent: 'function optimized() { return 42; }',
