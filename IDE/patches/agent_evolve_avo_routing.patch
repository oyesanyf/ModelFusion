+			background: linear-gradient(90deg, #38bdf8, #c084fc);
+			-webkit-background-clip: text;
+			-webkit-text-fill-color: transparent;
+		}
+
+		.brand-subtitle {
+			font-size: 11px;
+			color: var(--text-dim);
+			font-weight: 500;
+		}
+
+		.header-controls {
+			display: flex;
+			align-items: center;
+			gap: 8px;
+			flex-wrap: wrap;
+		}
+
+		/* Status Badges */
+		.status-badge {
+			display: inline-flex;
+			align-items: center;
+			gap: 6px;
+			padding: 4px 10px;
+			border-radius: 20px;
+			font-size: 11px;
+			font-weight: 600;
+			background: rgba(15, 23, 42, 0.8);
+			border: 1px solid var(--border-glass);
