+    assert.equal(timeout, 120 + 200 + 100);
+  });
+
+  it('INT-14: WiX Directory Tree + Authenticode Binary Signing + MSI Metadata', () => {
+    const sig = verifyAuthenticodeSignature('IDE/HugOS.msi');
+    assert.equal(sig.verified, true);
