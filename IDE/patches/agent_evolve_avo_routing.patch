+			--accent-cyan: #38bdf8;
+			--accent-indigo: #818cf8;
+			--accent-purple: #c084fc;
+			--accent-emerald: #10b981;
+			--accent-rose: #f43f5e;
+			--accent-amber: #f59e0b;
+			--text-main: #f8fafc;
+			--text-muted: #94a3b8;
+			--text-dim: #64748b;
+			--glass-blur: blur(16px);
