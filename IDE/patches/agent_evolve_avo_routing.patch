+		.status-dot {
+			width: 7px;
+			height: 7px;
+			border-radius: 50%;
+			background: var(--text-dim);
+		}
+
+		.status-dot.online {
+			background: var(--accent-emerald);
+			box-shadow: 0 0 8px var(--accent-emerald);
+			animation: pulseDot 2s infinite ease-in-out;
