+
+	/**
+	 * Applies candidate patch code directly to the workspace file atomically using WorkspaceEdit,
+	 * creates a snapshot backup for rollback, saves the document, and updates candidate status.
+	 */
+	public async applyCandidatePatch(
+		candidateId: string,
+		filePath: string,
+		candidateContent?: string
+	): Promise<boolean> {
+		const candidate = this._stateManager.getCandidate(candidateId);
+		if (!candidate && candidateContent === undefined) {
+			throw new Error(`Candidate ${candidateId} not found`);
+		}
+
+		const newText = candidateContent !== undefined ? candidateContent : candidate!.candidateContent;
+		const fileUri = vscode.Uri.file(filePath);
+
+		// Record automatic backup snapshot prior to mutation
+		if (!this.backupHistory.has(filePath)) {
+			let currentContent: string | undefined;
+
+			if (this._vscodeEnv?.workspaceFiles?.has(filePath)) {
+				currentContent = this._vscodeEnv.workspaceFiles.get(filePath);
+			} else {
+				try {
+					const doc = await vscode.workspace.openTextDocument(fileUri);
+					currentContent = doc.getText();
+				} catch {
+					if (fs.existsSync(filePath)) {
+						try {
+							currentContent = fs.readFileSync(filePath, 'utf-8');
+						} catch {
+							currentContent = undefined;
+						}
+					}
+				}
+			}
+
+			if (currentContent !== undefined) {
+				this.backupHistory.set(filePath, currentContent);
+			}
+		}
+
+		// Perform atomic WorkspaceEdit
+		const edit = new vscode.WorkspaceEdit();
+		let fileExists = false;
+		let lineCount = 0;
+
+		try {
+			const doc = await vscode.workspace.openTextDocument(fileUri);
+			fileExists = true;
+			lineCount = doc.lineCount;
+		} catch {
+			fileExists = fs.existsSync(filePath) || (this._vscodeEnv?.workspaceFiles?.has(filePath) ?? false);
+		}
+
+		if (fileExists) {
+			const fullRange = new vscode.Range(0, 0, Math.max(lineCount, 100000), 0);
+			edit.replace(fileUri, fullRange, newText);
+		} else {
+			try {
+				if (typeof (edit as any).createFile === 'function') {
+					(edit as any).createFile(fileUri, { overwrite: true, ignoreIfExists: true });
+				}
+				edit.insert(fileUri, new vscode.Position(0, 0), newText);
+			} catch {
+				edit.replace(fileUri, new vscode.Range(0, 0, 0, 0), newText);
+			}
+		}
+
+		let success = false;
+		if (this._vscodeEnv && typeof this._vscodeEnv.applyEdit === 'function') {
+			success = await this._vscodeEnv.applyEdit(edit);
+		} else {
+			success = await vscode.workspace.applyEdit(edit);
+		}
+
+		if (success) {
+			if (this._vscodeEnv?.workspaceFiles) {
+				this._vscodeEnv.workspaceFiles.set(filePath, newText);
+			}
+			try {
+				const doc = await vscode.workspace.openTextDocument(fileUri);
+				await doc.save();
+			} catch {
+				// Ignore save error in non-standard/mock environments
+			}
+			this._stateManager.updateCandidateStatus(candidateId, 'applied');
+		}
+
+		return success;
+	}
+
+	/**
+	 * Reverts workspace file back to its snapshot backup state prior to candidate patch apply.
+	 */
+	public async rollbackPatch(filePath: string): Promise<boolean> {
+		if (!this.backupHistory.has(filePath)) {
+			throw new Error(`No backup found for ${filePath}`);
+		}
+
+		const originalContent = this.backupHistory.get(filePath)!;
+		const fileUri = vscode.Uri.file(filePath);
+
+		const edit = new vscode.WorkspaceEdit();
+		let lineCount = 100000;
+		try {
+			const doc = await vscode.workspace.openTextDocument(fileUri);
+			lineCount = doc.lineCount;
+		} catch {
+			// fallback
+		}
+
+		const fullRange = new vscode.Range(0, 0, Math.max(lineCount, 100000), 0);
+		edit.replace(fileUri, fullRange, originalContent);
+
+		let success = false;
+		if (this._vscodeEnv && typeof this._vscodeEnv.applyEdit === 'function') {
+			success = await this._vscodeEnv.applyEdit(edit);
+		} else {
+			success = await vscode.workspace.applyEdit(edit);
+		}
+
+		if (success) {
+			if (this._vscodeEnv?.workspaceFiles) {
+				this._vscodeEnv.workspaceFiles.set(filePath, originalContent);
+			}
+			try {
+				const doc = await vscode.workspace.openTextDocument(fileUri);
+				await doc.save();
+			} catch {
+				// Ignore save error in non-standard/mock environments
+			}
+			this.backupHistory.delete(filePath);
+		}
+
+		return success;
+	}
+
+	/**
+	 * Alias for rollbackPatch
+	 */
+	public async rollbackCandidatePatch(filePath: string): Promise<boolean> {
+		return this.rollbackPatch(filePath);
+	}
+
+	public getBackup(filePath: string): string | undefined {
+		return this.backupHistory.get(filePath);
+	}
+
+	public hasBackup(filePath: string): boolean {
+		return this.backupHistory.has(filePath);
+	}
+
+	override dispose(): void {
+		if (CandidateApplier._instance === this) {
+			CandidateApplier._instance = undefined;
+		}
+		this.backupHistory.clear();
+		super.dispose();
+	}
+}
