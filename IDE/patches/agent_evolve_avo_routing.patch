+					<div style="display: flex; justify-content: space-between;">
+						<span style="color: var(--text-muted);">Dropped Events (Overflow):</span>
+						<span style="font-weight: 700; color: var(--accent-emerald);" id="diagDropped">0</span>
+					</div>
+				</div>
+			</div>
+
+			<div class="card">
+				<div class="card-header">
+					<div class="card-title">🖥 ModelFusion Backend Health</div>
+				</div>
+				<div style="display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
+					<div style="display: flex; justify-content: space-between;">
+						<span style="color: var(--text-muted);">HTTP API Endpoint:</span>
+						<span style="font-family: monospace;">http://127.0.0.1:5000</span>
+					</div>
+					<div style="display: flex; justify-content: space-between;">
+						<span style="color: var(--text-muted);">MCP Server Status:</span>
+						<span style="font-weight: 700; color: var(--accent-emerald);" id="diagMcp">Online</span>
+					</div>
+					<div style="display: flex; justify-content: space-between;">
+						<span style="color: var(--text-muted);">IPC Round-Trip Latency:</span>
+						<span style="font-weight: 700;" id="diagLatency">4 ms</span>
+					</div>
+					<div style="display: flex; justify-content: space-between;">
+						<span style="color: var(--text-muted);">Memory Usage:</span>
+						<span style="font-weight: 700;" id="diagMemory">85.4 MB</span>
+					</div>
+					<div style="display: flex; justify-content: space-between;">
+						<span style="color: var(--text-muted);">Task Queue Depth:</span>
+						<span style="font-weight: 700;" id="diagQueue">0 active</span>
+					</div>
+				</div>
+			</div>
+		</div>
+	</section>
+
+	<script nonce="${nonce}">
+		const vscode = acquireVsCodeApi();
+
+		// Local State Cache
+		let state = {
+			runState: {
+				runId: '',
+				status: 'idle',
+				mode: 'openevolve',
+				targetDir: 'src/',
+				currentIteration: 0,
+				maxIterations: 20,
+				currentFitness: 0,
+				bestFitness: 0
+			},
+			activePreset: null,
+			presets: [],
+			agents: [],
+			metricsHistory: [],
+			candidates: [],
+			thoughts: [],
+			backendStats: {
+				connected: false,
+				latencyMs: 0,
+				mcpServerStatus: 'offline',
+				memoryUsageMb: 0
+			},
+			telemetry: {
+				fps: 60,
+				totalEventsEnqueued: 0,
+				totalEventsDispatched: 0,
+				droppedEventsCount: 0
+			}
+		};
+
+		// Tab Switching
+		document.querySelectorAll('.tab-btn').forEach(btn => {
+			btn.addEventListener('click', () => {
+				document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
+				document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
+				btn.classList.add('active');
+				const targetPane = document.getElementById(btn.getAttribute('data-tab'));
+				if (targetPane) {
+					targetPane.classList.add('active');
+				}
+				if (btn.getAttribute('data-tab') === 'studioTab') {
+					requestAnimationFrame(renderChart);
+				}
+			});
+		});
+
+		// Slider input sync
+		const slider = document.getElementById('iterationsSlider');
+		const sliderLabel = document.getElementById('generationCountLabel');
+		slider.addEventListener('input', (e) => {
+			sliderLabel.textContent = e.target.value;
+		});
+
+		// Preset selection
+		const presetSelect = document.getElementById('presetSelector');
+		presetSelect.addEventListener('change', (e) => {
+			vscode.postMessage({
+				type: 'applyPreset',
+				presetId: e.target.value
+			});
+		});
+
+		// Controls
+		document.getElementById('refreshBtn').addEventListener('click', () => {
+			vscode.postMessage({ type: 'refreshStats' });
+		});
+
+		document.getElementById('resetBtn').addEventListener('click', () => {
+			vscode.postMessage({ type: 'resetState' });
+		});
+
+		document.getElementById('launchRunBtn').addEventListener('click', () => {
+			const targetDir = document.getElementById('targetDirInput').value || 'src/';
+			const mode = document.getElementById('evolutionModeSelect').value || 'openevolve';
+			const iterations = parseInt(slider.value, 10) || 20;
+
+			vscode.postMessage({
+				type: 'launchEvolution',
+				config: { targetDir, mode, iterations }
+			});
+		});
+
+		document.getElementById('pauseRunBtn').addEventListener('click', () => {
+			if (state.runState.status === 'running') {
+				vscode.postMessage({ type: 'pauseEvolution' });
+			} else if (state.runState.status === 'paused') {
+				vscode.postMessage({ type: 'resumeEvolution' });
+			}
+		});
+
+		document.getElementById('stopRunBtn').addEventListener('click', () => {
+			vscode.postMessage({ type: 'stopEvolution' });
+		});
+
+		document.getElementById('clearConsoleBtn').addEventListener('click', () => {
+			state.thoughts = [];
+			renderThoughts();
+		});
+
+		document.getElementById('thoughtSearch').addEventListener('input', () => {
+			renderThoughts();
+		});
+
+		document.getElementById('thoughtRoleFilter').addEventListener('change', () => {
+			renderThoughts();
+		});
+
+		// IPC Message Dispatcher
+		window.addEventListener('message', event => {
+			const message = event.data;
+			if (!message) return;
+
+			switch (message.type) {
+				case 'fullStateSnapshot':
+					handleFullSnapshot(message.payload);
+					break;
+				case 'batchEvents':
+					handleBatchEvents(message);
+					break;
+				case 'evolutionState':
+					updateRunState(message.payload);
+					break;
+				case 'evolutionStep':
+					appendMetricPoint(message.payload);
+					break;
+				case 'agentThoughtStream':
+					appendThought(message.payload);
+					break;
+				case 'candidateUpdate':
+					upsertCandidate(message.payload);
+					break;
+				case 'teamPresetChanged':
+					updatePreset(message.payload);
+					break;
+				case 'teamStateUpdate':
+					updateAgents(message.payload.agents);
+					break;
+				case 'backendStats':
+					updateBackendStats(message.payload);
+					break;
+				case 'stateReset':
+					handleReset();
+					break;
+			}
+		});
+
+		function handleFullSnapshot(snap) {
+			if (!snap) return;
+			if (snap.runState) state.runState = snap.runState;
+			if (snap.activePreset) state.activePreset = snap.activePreset;
+			if (snap.presets) state.presets = snap.presets;
+			if (snap.agents) state.agents = snap.agents;
+			if (snap.metricsHistory) state.metricsHistory = snap.metricsHistory;
+			if (snap.candidates) state.candidates = snap.candidates;
+			if (snap.thoughts) state.thoughts = snap.thoughts;
+			if (snap.backendStats) state.backendStats = snap.backendStats;
+			if (snap.telemetry) state.telemetry = snap.telemetry;
+
+			renderAll();
+		}
+
+		function handleBatchEvents(batch) {
+			if (batch.fps) {
+				document.getElementById('fpsText').textContent = batch.fps + ' FPS';
+				document.getElementById('diagFps').textContent = batch.fps + ' FPS (16.6ms)';
+			}
+
+			for (const evt of batch.events) {
+				switch (evt.type) {
+					case 'evolutionState':
+						updateRunState(evt.payload);
+						break;
+					case 'evolutionStep':
+						appendMetricPoint(evt.payload);
+						break;
+					case 'agentThoughtStream':
+						appendThought(evt.payload);
+						break;
+					case 'candidateUpdate':
+						upsertCandidate(evt.payload);
+						break;
+					case 'teamPresetChanged':
+						updatePreset(evt.payload);
+						break;
+					case 'teamStateUpdate':
+						updateAgents(evt.payload.agents);
+						break;
+					case 'backendStats':
+						updateBackendStats(evt.payload);
+						break;
+					case 'stateReset':
+						handleReset();
+						break;
+				}
+			}
+
+			state.telemetry.totalEventsDispatched += batch.events.length;
+			document.getElementById('eventCountBadge').textContent = state.telemetry.totalEventsDispatched;
+			document.getElementById('diagDispatched').textContent = state.telemetry.totalEventsDispatched;
+		}
+
+		function updateRunState(runState) {
+			state.runState = runState;
+			const statusBadge = document.getElementById('runStatusBadge');
+			statusBadge.textContent = runState.status.toUpperCase();
+
+			const launchBtn = document.getElementById('launchRunBtn');
+			const pauseBtn = document.getElementById('pauseRunBtn');
+			const stopBtn = document.getElementById('stopRunBtn');
+
+			if (runState.status === 'running') {
+				launchBtn.disabled = true;
+				pauseBtn.disabled = false;
+				pauseBtn.textContent = '⏸ Pause';
+				stopBtn.disabled = false;
+			} else if (runState.status === 'paused') {
+				launchBtn.disabled = true;
+				pauseBtn.disabled = false;
+				pauseBtn.textContent = '▶ Resume';
+				stopBtn.disabled = false;
+			} else {
+				launchBtn.disabled = false;
+				pauseBtn.disabled = true;
+				stopBtn.disabled = true;
+			}
+
+			document.getElementById('kpiGeneration').textContent = runState.currentIteration + ' / ' + runState.maxIterations;
+			const progress = runState.maxIterations > 0 ? Math.round((runState.currentIteration / runState.maxIterations) * 100) : 0;
+			document.getElementById('kpiProgressPct').textContent = progress + '% Complete';
+			document.getElementById('kpiBestFitness').textContent = (runState.bestFitness * 100).toFixed(1) + '%';
+
+			renderChart();
+		}
+
+		function appendMetricPoint(point) {
+			state.metricsHistory.push(point);
+			if (state.metricsHistory.length > 2000) state.metricsHistory.shift();
+
+			document.getElementById('kpiGeneration').textContent = point.generation + ' / ' + state.runState.maxIterations;
+			document.getElementById('kpiBestFitness').textContent = (point.bestFitness * 100).toFixed(1) + '%';
+			document.getElementById('kpiTokens').textContent = point.tokenCount.toLocaleString();
+			document.getElementById('kpiPassRate').textContent = (point.passRate * 100).toFixed(0) + '% Pass Rate';
+
+			renderChart();
+		}
+
+		function appendThought(thought) {
+			state.thoughts.push(thought);
+			if (state.thoughts.length > 500) state.thoughts.shift();
+			renderThoughts();
+		}
+
+		function upsertCandidate(candidate) {
+			const idx = state.candidates.findIndex(c => c.candidateId === candidate.candidateId);
+			if (idx >= 0) {
+				state.candidates[idx] = candidate;
+			} else {
+				state.candidates.unshift(candidate);
+			}
+			document.getElementById('kpiCandidateCount').textContent = state.candidates.length;
+			renderCandidates();
+		}
+
+		function updatePreset(preset) {
+			state.activePreset = preset;
+			presetSelect.value = preset.id;
+			document.getElementById('presetName').textContent = preset.name;
+			document.getElementById('presetDesc').textContent = preset.description;
+			document.getElementById('presetModeBadge').textContent = preset.defaultMode.toUpperCase() + ' MODE';
+		}
+
+		function updateAgents(agents) {
+			state.agents = agents;
+			document.getElementById('agentsCountBadge').textContent = agents.length;
+			renderAgents();
+		}
+
+		function updateBackendStats(stats) {
+			state.backendStats = stats;
+			const dot = document.getElementById('statusDot');
+			const text = document.getElementById('backendStatusText');
+
+			if (stats.connected) {
+				dot.className = 'status-dot online';
+				text.textContent = 'ModelFusion (' + stats.latencyMs + 'ms)';
+				document.getElementById('diagMcp').textContent = stats.mcpServerStatus.toUpperCase();
+				document.getElementById('diagLatency').textContent = stats.latencyMs + ' ms';
+				document.getElementById('diagMemory').textContent = stats.memoryUsageMb.toFixed(1) + ' MB';
+				document.getElementById('diagQueue').textContent = stats.queueDepth + ' active';
+			} else {
+				dot.className = 'status-dot offline';
+				text.textContent = 'ModelFusion Offline';
+				document.getElementById('diagMcp').textContent = 'OFFLINE';
+			}
+		}
+
+		function handleReset() {
+			state.metricsHistory = [];
+			state.candidates = [];
+			state.thoughts = [];
+			updateRunState({
+				runId: '',
+				status: 'idle',
+				mode: 'openevolve',
+				targetDir: 'src/',
+				currentIteration: 0,
+				maxIterations: 20,
+				currentFitness: 0,
+				bestFitness: 0
+			});
+			renderAll();
+		}
+
+		function renderAll() {
+			if (state.activePreset) updatePreset(state.activePreset);
+			if (state.agents) updateAgents(state.agents);
+			if (state.runState) updateRunState(state.runState);
+			if (state.backendStats) updateBackendStats(state.backendStats);
+			renderThoughts();
+			renderCandidates();
+			renderChart();
+		}
+
+		function renderAgents() {
+			const container = document.getElementById('agentsGrid');
+			container.innerHTML = '';
+
+			for (const agent of state.agents) {
+				const card = document.createElement('div');
+				card.className = 'card agent-card ' + agent.role;
+
+				const statusDotClass = agent.status === 'active' ? 'online' : (agent.status === 'error' ? 'offline' : '');
+
+				card.innerHTML = \`
+					<div class="card-header">
+						<div class="card-title">
+							<span class="status-dot \${statusDotClass}"></span>
+							<span>\${escapeHtml(agent.name)}</span>
+						</div>
+						<span class="agent-role-badge role-\${agent.role}">\${agent.role.replace('_', ' ')}</span>
+					</div>
+					<div style="display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;">
+						<span>Model: <b style="color: var(--text-main);">\${agent.model}</b></span>
+						<span>Tokens: <b style="color: var(--accent-cyan);">\${agent.tokensConsumed.toLocaleString()}</b></span>
+					</div>
+					<div class="agent-task" title="\${escapeHtml(agent.currentTask || 'Idle / Ready')}">
+						\${escapeHtml(agent.currentTask || 'Status: Idle / Ready for dispatch')}
+					</div>
+				\`;
+				container.appendChild(card);
+			}
+		}
+
+		function renderThoughts() {
+			const container = document.getElementById('thoughtLogsContainer');
+			const search = (document.getElementById('thoughtSearch').value || '').toLowerCase();
+			const roleFilter = document.getElementById('thoughtRoleFilter').value;
+
+			const filtered = state.thoughts.filter(t => {
+				if (roleFilter !== 'all' && t.role !== roleFilter) return false;
+				if (search && !t.thought.toLowerCase().includes(search) && !t.role.toLowerCase().includes(search)) return false;
+				return true;
+			});
+
+			container.innerHTML = '';
+			if (filtered.length === 0) {
+				container.innerHTML = '<div style="color: var(--text-dim); padding: 10px;">No thoughts matching filter.</div>';
+				return;
+			}
+
+			for (const item of filtered) {
+				const row = document.createElement('div');
+				row.className = 'log-entry';
+
+				const timeStr = new Date(item.timestamp).toTimeString().substring(0, 8);
+				const tagClass = 'tag-' + (item.level || 'thought');
+
+				row.innerHTML = \`
+					<span class="log-time">\${timeStr}</span>
+					<span class="log-tag \${tagClass}">\${escapeHtml(item.role.toUpperCase())}</span>
+					<span class="log-text">\${escapeHtml(item.thought)}</span>
+				\`;
+				container.appendChild(row);
+			}
+
+			container.scrollTop = container.scrollHeight;
+		}
+
+		function renderCandidates() {
+			const container = document.getElementById('candidateListContainer');
+			container.innerHTML = '';
+
+			if (state.candidates.length === 0) {
+				container.innerHTML = '<div style="font-size: 12px; color: var(--text-dim); text-align: center; padding: 20px;">No candidate patches generated yet.</div>';
+				return;
+			}
+
+			for (const cand of state.candidates) {
+				const item = document.createElement('div');
+				item.className = 'candidate-card';
+
+				item.innerHTML = \`
+					<div class="candidate-meta">
+						<div class="candidate-title">
+							<span>Candidate #\${escapeHtml(cand.candidateId.substring(0, 8))}</span>
+							<span class="candidate-score">\${(cand.fitness * 100).toFixed(1)}% Fitness</span>
+							<span style="font-size: 10px; color: var(--text-dim);">Gen \${cand.generation}</span>
+						</div>
+						<div class="candidate-desc">\${escapeHtml(cand.summary || cand.filePath)}</div>
+					</div>
+					<div class="candidate-actions">
+						<button class="btn btn-secondary diff-btn" style="padding: 4px 8px; font-size: 11px;">Diff</button>
+						<button class="btn btn-primary apply-btn" style="padding: 4px 8px; font-size: 11px;">Apply</button>
+					</div>
+				\`;
+
+				item.querySelector('.diff-btn').addEventListener('click', () => {
+					vscode.postMessage({
+						type: 'openCandidateDiff',
+						candidateId: cand.candidateId,
+						filePath: cand.filePath,
+						originalContent: cand.originalContent,
+						candidateContent: cand.candidateContent
+					});
+				});
+
+				item.querySelector('.apply-btn').addEventListener('click', () => {
+					vscode.postMessage({
+						type: 'applyCandidatePatch',
+						candidateId: cand.candidateId,
+						filePath: cand.filePath,
+						candidateContent: cand.candidateContent
+					});
+				});
+
+				container.appendChild(item);
+			}
+		}
+
+		// 60FPS Fitness Chart Rendering Engine
+		function renderChart() {
+			const canvas = document.getElementById('fitnessCanvas');
+			if (!canvas) return;
+
+			const rect = canvas.getBoundingClientRect();
+			if (rect.width === 0 || rect.height === 0) return;
+
+			const dpr = window.devicePixelRatio || 1;
+			canvas.width = rect.width * dpr;
+			canvas.height = rect.height * dpr;
+
+			const ctx = canvas.getContext('2d');
+			ctx.scale(dpr, dpr);
+
+			const w = rect.width;
+			const h = rect.height;
+			const padding = { left: 40, right: 20, top: 20, bottom: 30 };
+			const plotW = w - padding.left - padding.right;
+			const plotH = h - padding.top - padding.bottom;
+
+			// Background & Grid
+			ctx.clearRect(0, 0, w, h);
+			ctx.fillStyle = '#080d1a';
+			ctx.fillRect(0, 0, w, h);
+
+			ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
+			ctx.lineWidth = 1;
+
+			// Horizontal grid lines (0.0 to 1.0)
+			ctx.fillStyle = '#64748b';
+			ctx.font = '10px monospace';
+			ctx.textAlign = 'right';
+
+			for (let i = 0; i <= 4; i++) {
+				const y = padding.top + (plotH / 4) * i;
+				const val = (1.0 - (i * 0.25)).toFixed(2);
+
+				ctx.beginPath();
+				ctx.moveTo(padding.left, y);
+				ctx.lineTo(w - padding.right, y);
+				ctx.stroke();
+
+				ctx.fillText(val, padding.left - 6, y + 3);
+			}
+
+			const history = state.metricsHistory;
+			const maxGen = Math.max(state.runState.maxIterations || 20, history.length > 0 ? history[history.length - 1].generation : 20);
+
+			// Vertical grid lines
+			ctx.textAlign = 'center';
+			for (let g = 0; g <= maxGen; g += Math.max(1, Math.floor(maxGen / 5))) {
+				const x = padding.left + (g / maxGen) * plotW;
+				ctx.beginPath();
+				ctx.moveTo(x, padding.top);
+				ctx.lineTo(x, h - padding.bottom);
+				ctx.stroke();
+
+				ctx.fillText('G' + g, x, h - padding.bottom + 14);
+			}
+
+			if (history.length === 0) return;
+
+			// Draw Best Fitness Filled Curve
+			ctx.beginPath();
+			ctx.moveTo(padding.left, h - padding.bottom);
+			for (let i = 0; i < history.length; i++) {
+				const pt = history[i];
+				const x = padding.left + (pt.generation / maxGen) * plotW;
+				const y = padding.top + (1.0 - Math.min(1.0, Math.max(0, pt.bestFitness))) * plotH;
+				ctx.lineTo(x, y);
+			}
+			const lastX = padding.left + (history[history.length - 1].generation / maxGen) * plotW;
+			ctx.lineTo(lastX, h - padding.bottom);
+			ctx.closePath();
+
+			const fillGrad = ctx.createLinearGradient(0, padding.top, 0, h - padding.bottom);
+			fillGrad.addColorStop(0, 'rgba(56, 189, 248, 0.25)');
+			fillGrad.addColorStop(1, 'rgba(56, 189, 248, 0.0)');
+			ctx.fillStyle = fillGrad;
+			ctx.fill();
+
+			// Draw Best Fitness Line (Cyan)
+			ctx.beginPath();
+			for (let i = 0; i < history.length; i++) {
+				const pt = history[i];
+				const x = padding.left + (pt.generation / maxGen) * plotW;
+				const y = padding.top + (1.0 - Math.min(1.0, Math.max(0, pt.bestFitness))) * plotH;
+				if (i === 0) ctx.moveTo(x, y);
+				else ctx.lineTo(x, y);
+			}
+			ctx.strokeStyle = '#38bdf8';
+			ctx.lineWidth = 2.5;
+			ctx.shadowColor = '#38bdf8';
+			ctx.shadowBlur = 8;
+			ctx.stroke();
+			ctx.shadowBlur = 0;
+
+			// Draw Current Step Fitness Line (Rose)
+			ctx.beginPath();
+			for (let i = 0; i < history.length; i++) {
+				const pt = history[i];
+				const x = padding.left + (pt.generation / maxGen) * plotW;
+				const y = padding.top + (1.0 - Math.min(1.0, Math.max(0, pt.fitness))) * plotH;
+				if (i === 0) ctx.moveTo(x, y);
+				else ctx.lineTo(x, y);
+			}
+			ctx.strokeStyle = '#f43f5e';
+			ctx.lineWidth = 1.5;
+			ctx.stroke();
+
+			// Draw Candidate Nodes (Emerald Dots)
+			for (let i = 0; i < history.length; i++) {
+				const pt = history[i];
+				if (pt.candidateId) {
+					const x = padding.left + (pt.generation / maxGen) * plotW;
+					const y = padding.top + (1.0 - Math.min(1.0, Math.max(0, pt.fitness))) * plotH;
+					ctx.fillStyle = '#10b981';
+					ctx.beginPath();
+					ctx.arc(x, y, 3.5, 0, Math.PI * 2);
+					ctx.fill();
+				}
+			}
+		}
+
+		window.addEventListener('resize', () => {
+			renderChart();
+		});
+
+		function escapeHtml(str) {
+			if (!str) return '';
+			return String(str)
+				.replace(/&/g, '&amp;')
+				.replace(/</g, '&lt;')
+				.replace(/>/g, '&gt;')
+				.replace(/"/g, '&quot;')
+				.replace(/'/g, '&#039;');
+		}
+	</script>
+</body>
+</html>`;
+}
+
+function getNonce(): string {
+	let text = '';
+	const possible = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
+	for (let i = 0; i < 32; i++) {
+		text += possible.charAt(Math.floor(Math.random() * possible.length));
+	}
+	return text;
+}
