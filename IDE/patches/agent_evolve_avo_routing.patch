+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+import { Disposable, IDisposable } from '../../util/vs/base/common/lifecycle';
+import { ILogService } from '../../platform/log/common/logService';
+import { EvolutionStateManager, EvolutionMode } from './evolutionStateManager';
+import { TeamPresetManager } from './teamPresetManager';
+import { EventStreamService } from './eventStreamService';
+import { getDashboardHtml } from './dashboardHtml';
+
+export class DashboardViewProvider extends Disposable implements vscode.WebviewViewProvider {
+	public static readonly viewType = 'hugos.dashboardView';
+	public static readonly panelType = 'hugos.dashboardPanel';
+
+	private _view?: vscode.WebviewView;
+	private _panel?: vscode.WebviewPanel;
+	private readonly _webviewDisposables = new Map<vscode.Webview, IDisposable>();
+
+	constructor(
+		private readonly _extensionUri: vscode.Uri,
+		private readonly _stateManager: EvolutionStateManager,
+		private readonly _presetManager: TeamPresetManager,
+		private readonly _eventStreamService: EventStreamService,
+		@ILogService private readonly _logService: ILogService
+	) {
+		super();
+	}
+
+	public resolveWebviewView(
+		webviewView: vscode.WebviewView,
+		_context: vscode.WebviewViewResolveContext,
+		_token: vscode.CancellationToken
+	): void {
+		this._view = webviewView;
+
+		webviewView.webview.options = {
+			enableScripts: true,
+			localResourceRoots: [this._extensionUri]
+		};
+
+		webviewView.webview.html = getDashboardHtml(webviewView.webview, this._extensionUri);
+		this._bindWebview(webviewView.webview);
+
+		webviewView.onDidDispose(() => {
+			this._unbindWebview(webviewView.webview);
+			this._view = undefined;
+		});
+	}
+
+	public openInPanel(): vscode.WebviewPanel {
+		if (this._panel) {
+			this._panel.reveal(vscode.ViewColumn.Active);
+			return this._panel;
+		}
+
+		this._panel = vscode.window.createWebviewPanel(
+			DashboardViewProvider.panelType,
+			'HugOS Studio Dashboard',
+			vscode.ViewColumn.Active,
+			{
+				enableScripts: true,
+				retainContextWhenHidden: true,
+				localResourceRoots: [this._extensionUri]
+			}
+		);
+
+		this._panel.iconPath = vscode.Uri.joinPath(this._extensionUri, 'assets', 'hugos-icon.svg');
+		this._panel.webview.html = getDashboardHtml(this._panel.webview, this._extensionUri);
+		this._bindWebview(this._panel.webview);
+
+		this._panel.onDidDispose(() => {
+			if (this._panel) {
+				this._unbindWebview(this._panel.webview);
+			}
+			this._panel = undefined;
+		});
+
+		return this._panel;
+	}
+
+	public refresh(): void {
+		if (this._view) {
+			this._view.webview.html = getDashboardHtml(this._view.webview, this._extensionUri);
+		}
+		if (this._panel) {
+			this._panel.webview.html = getDashboardHtml(this._panel.webview, this._extensionUri);
+		}
+	}
+
+	public resetState(): void {
+		this._stateManager.resetState();
+	}
+
+	private _bindWebview(webview: vscode.Webview): void {
+		const registrationDisposable = this._eventStreamService.registerWebview(webview);
+
+		const messageDisposable = webview.onDidReceiveMessage(async (message) => {
+			try {
+				await this._handleMessage(message, webview);
+			} catch (err: unknown) {
+				this._logService.error(`DashboardViewProvider: Error handling message "${message?.type}": ${err}`);
+			}
+		});
+
+		this._webviewDisposables.set(webview, {
+			dispose: () => {
+				registrationDisposable.dispose();
+				messageDisposable.dispose();
+			}
+		});
+	}
+
+	private _unbindWebview(webview: vscode.Webview): void {
+		const disposable = this._webviewDisposables.get(webview);
+		if (disposable) {
+			disposable.dispose();
+			this._webviewDisposables.delete(webview);
+		}
+	}
+
+	private async _handleMessage(message: any, _webview: vscode.Webview): Promise<void> {
+		if (!message || typeof message.type !== 'string') {
+			return;
+		}
+
+		this._logService.trace(`DashboardViewProvider: Received message "${message.type}"`);
+
+		switch (message.type) {
+			case 'launchEvolution': {
+				const config = message.config || {};
+				const targetDir = config.targetDir || 'src/';
+				const iterations = config.iterations || 20;
+				const mode: EvolutionMode = config.mode || 'openevolve';
+
+				this._stateManager.startRun({
+					targetDir,
+					iterations,
+					mode
+				});
+
+				// Asynchronously trigger the ModelFusion evolution pipeline if registered
+				try {
+					const { ModelFusionLMProvider } = await import('../byok/vscode-node/modelFusionProvider');
+					const provider = ModelFusionLMProvider.getInstance();
+					if (provider) {
+						provider.launchEvolutionPipeline(targetDir, iterations, mode).catch(err => {
+							this._logService.warn(`DashboardViewProvider: Error in launched pipeline: ${err}`);
+						});
+					}
+				} catch (err) {
+					this._logService.trace(`DashboardViewProvider: ModelFusion provider not dynamically available: ${err}`);
+				}
+				break;
+			}
+
+			case 'pauseEvolution': {
+				this._stateManager.pauseRun();
+				break;
+			}
+
+			case 'resumeEvolution': {
+				this._stateManager.resumeRun();
+				break;
+			}
+
+			case 'stopEvolution': {
+				this._stateManager.stopRun();
+				break;
+			}
+
+			case 'applyPreset': {
+				const presetId = message.presetId;
+				if (presetId) {
+					this._presetManager.applyPreset(presetId);
+				}
+				break;
+			}
+
+			case 'refreshStats': {
+				this.refresh();
+				break;
+			}
+
+			case 'resetState': {
+				this.resetState();
+				break;
+			}
+
+			case 'openCandidateDiff': {
+				// Forward to candidate diff handler or command
+				try {
+					await vscode.commands.executeCommand(
+						'hugos.candidate.openDiff',
+						message.candidateId,
+						message.filePath,
+						message.originalContent,
+						message.candidateContent
+					);
+				} catch {
+					// Fallback if command not yet registered
+					this._logService.warn(`Candidate diff command invoked for ${message.candidateId}`);
+				}
+				break;
+			}
+
+			case 'applyCandidatePatch': {
+				try {
+					await vscode.commands.executeCommand(
+						'hugos.candidate.applyPatch',
+						message.candidateId,
+						message.filePath,
+						message.candidateContent
+					);
+				} catch {
+					this._logService.warn(`Candidate patch apply invoked for ${message.candidateId}`);
+				}
+				break;
+			}
+		}
+	}
+
+	override dispose(): void {
+		for (const disposable of this._webviewDisposables.values()) {
+			disposable.dispose();
+		}
+		this._webviewDisposables.clear();
+		if (this._panel) {
+			this._panel.dispose();
+		}
+		super.dispose();
+	}
+}
diff --git a/extensions/copilot/src/extension/dashboard/eventStreamService.ts b/extensions/copilot/src/extension/dashboard/eventStreamService.ts
