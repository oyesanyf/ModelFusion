+
+import { describe, it, expect } from 'vitest';
+import { TeamPresetManager } from '../teamPresetManager';
+import { EvolutionStateManager } from '../evolutionStateManager';
+import { AsyncRingBuffer } from '../eventStreamService';
+
+describe('Dashboard M1 & M2 Vitest Specification', () => {
+
+	// ═══════════════════════════════════════════════════════════════════
+	// TeamPresetManager
+	// ═══════════════════════════════════════════════════════════════════
+	describe('TeamPresetManager', () => {
+		it('initializes with 4 built-in presets', () => {
+			const manager = new TeamPresetManager();
+			const presets = manager.getPresets();
+			expect(presets.length).toBe(4);
+
+			const ids = presets.map(p => p.id);
+			expect(ids).toContain('architect_worker_swarm');
+			expect(ids).toContain('avo_optimizer');
+			expect(ids).toContain('local_sandbox');
+			expect(ids).toContain('security_auditor');
+		});
+
+		it('default active preset is architect_worker_swarm with 4 agents', () => {
+			const manager = new TeamPresetManager();
+			const active = manager.getActivePreset();
+			expect(active.id).toBe('architect_worker_swarm');
+			expect(active.defaultMode).toBe('swarm');
+
+			const agents = manager.getAgents();
+			expect(agents.length).toBe(4);
+
+			const lead = manager.getAgent('agent_lead_architect');
+			expect(lead).toBeDefined();
+			expect(lead?.role).toBe('lead_architect');
+			expect(lead?.model).toBe('gemini-3.1-pro');
+		});
+
+		it('switches to AVO Optimizer preset', () => {
+			const manager = new TeamPresetManager();
+			const preset = manager.applyPreset('avo_optimizer');
+			expect(preset.id).toBe('avo_optimizer');
+			expect(manager.getActivePreset().id).toBe('avo_optimizer');
+
+			const agents = manager.getAgents();
+			expect(agents.length).toBe(3);
+
+			const avoAgent = manager.getAgent('agent_avo_mutation_lead');
+			expect(avoAgent).toBeDefined();
+			expect(avoAgent?.role).toBe('avo_agent');
+		});
+
+		it('updates agent status and token counters', () => {
+			const manager = new TeamPresetManager();
+			manager.updateAgentStatus('agent_lead_architect', 'busy', 'Decomposing AST refactor plan', 1250);
+
+			const lead = manager.getAgent('agent_lead_architect');
+			expect(lead?.status).toBe('busy');
+			expect(lead?.currentTask).toBe('Decomposing AST refactor plan');
+			expect(lead?.tokensConsumed).toBe(1250);
+		});
+
+		it('registers and applies custom preset', () => {
+			const manager = new TeamPresetManager();
+			manager.registerCustomPreset({
+				id: 'custom_bench_swarm',
+				name: 'Custom Bench Swarm',
+				description: 'Custom benchmark team',
+				defaultMode: 'swarm',
+				icon: 'rocket',
+				metadata: {},
+				agents: [
+					{
+						id: 'custom_agent_1',
+						name: 'Specialist',
+						role: 'worker',
+						model: 'gemini-3.7-flash',
+						temperature: 0.2,
+						maxTokens: 4096,
+						toolsEnabled: ['view_file'],
+						status: 'idle',
+						tokensConsumed: 0
+					}
+				]
+			});
+
+			const applied = manager.applyPreset('custom_bench_swarm');
+			expect(applied.id).toBe('custom_bench_swarm');
+			expect(manager.getAgents().length).toBe(1);
+		});
+	});
+
+	// ═══════════════════════════════════════════════════════════════════
+	// EvolutionStateManager
+	// ═══════════════════════════════════════════════════════════════════
+	describe('EvolutionStateManager', () => {
+		it('initializes with clean idle state', () => {
+			const stateManager = new EvolutionStateManager();
+			const runState = stateManager.getRunState();
+			expect(runState.status).toBe('idle');
+			expect(runState.currentIteration).toBe(0);
+			expect(runState.bestFitness).toBe(0);
+			expect(stateManager.getMetricsHistory().length).toBe(0);
+			expect(stateManager.getCandidates().length).toBe(0);
+		});
+
+		it('starts, pauses, resumes, and stops run', () => {
+			const stateManager = new EvolutionStateManager();
+			const runId = stateManager.startRun({
+				targetDir: 'src/lib',
+				iterations: 30,
+				mode: 'openevolve'
+			});
+
+			expect(runId.startsWith('run_')).toBe(true);
+			let state = stateManager.getRunState();
+			expect(state.status).toBe('running');
+			expect(state.targetDir).toBe('src/lib');
+			expect(state.maxIterations).toBe(30);
+
+			stateManager.pauseRun();
+			state = stateManager.getRunState();
+			expect(state.status).toBe('paused');
+
+			stateManager.resumeRun();
+			state = stateManager.getRunState();
+			expect(state.status).toBe('running');
+
+			stateManager.stopRun();
+			state = stateManager.getRunState();
+			expect(state.status).toBe('stopped');
+			expect(state.endTime).toBeGreaterThan(0);
+		});
+
+		it('records step progression and auto-completes on max iterations', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.startRun({
+				targetDir: 'src/',
+				iterations: 3,
+				mode: 'avo'
+			});
+
+			const pt1 = stateManager.recordStep({ generation: 1, fitness: 0.65, candidateId: 'c1' });
+			expect(pt1.fitness).toBe(0.65);
+			expect(pt1.bestFitness).toBe(0.65);
+			expect(stateManager.getRunState().bestFitness).toBe(0.65);
+
+			const pt2 = stateManager.recordStep({ generation: 2, fitness: 0.55 });
+			expect(pt2.bestFitness).toBe(0.65); // Retains historical best
+
+			const pt3 = stateManager.recordStep({ generation: 3, fitness: 0.88, candidateId: 'c3' });
+			expect(pt3.bestFitness).toBe(0.88);
+
+			// Reached max iterations (3) -> should auto complete
+			expect(stateManager.getRunState().status).toBe('completed');
+			expect(stateManager.getMetricsHistory().length).toBe(3);
+		});
+
+		it('adds and retrieves candidates and updates candidate status', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.addCandidate({
+				candidateId: 'cand_alpha_1',
+				generation: 1,
+				fitness: 0.84,
+				summary: 'Optimized loop vectorization',
+				diffSummary: '+15 -4 lines in math.ts',
+				filePath: 'src/math.ts',
+				candidateContent: 'export function compute() { return 42; }',
+				timestamp: Date.now(),
+				status: 'evaluated'
+			});
+
+			const cand = stateManager.getCandidate('cand_alpha_1');
+			expect(cand).toBeDefined();
+			expect(cand?.fitness).toBe(0.84);
+			expect(cand?.status).toBe('evaluated');
+
+			stateManager.updateCandidateStatus('cand_alpha_1', 'applied');
+			const updated = stateManager.getCandidate('cand_alpha_1');
+			expect(updated?.status).toBe('applied');
+		});
+
+		it('adds and retrieves agent thoughts', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.addThought({
+				agentId: 'agent_lead_architect',
+				role: 'lead_architect',
+				thought: 'Analyzed AST complexity, dispatching worker alpha.',
+				state: 'active',
+				level: 'thought'
+			});
+
+			const thoughts = stateManager.getThoughts();
+			expect(thoughts.length).toBeGreaterThanOrEqual(1);
+			const lastThought = thoughts[thoughts.length - 1];
+			expect(lastThought.role).toBe('lead_architect');
+			expect(lastThought.level).toBe('thought');
+		});
+
+		it('updates backend statistics and resets state', () => {
+			const stateManager = new EvolutionStateManager();
+			stateManager.updateBackendStats({
+				connected: true,
+				latencyMs: 6,
+				memoryUsageMb: 112.4,
+				mcpServerStatus: 'online'
+			});
+
+			const stats = stateManager.getBackendStats();
+			expect(stats.connected).toBe(true);
+			expect(stats.latencyMs).toBe(6);
+			expect(stats.mcpServerStatus).toBe('online');
+
+			stateManager.resetState();
+			expect(stateManager.getRunState().status).toBe('idle');
+			expect(stateManager.getMetricsHistory().length).toBe(0);
+			expect(stateManager.getCandidates().length).toBe(0);
+		});
+	});
+
+	// ═══════════════════════════════════════════════════════════════════
+	// AsyncRingBuffer
+	// ═══════════════════════════════════════════════════════════════════
+	describe('AsyncRingBuffer', () => {
+		it('maintains FIFO order during enqueue and drain', () => {
+			const ring = new AsyncRingBuffer<string>(8);
+			expect(ring.size).toBe(0);
+			expect(ring.capacity).toBe(8);
+
+			ring.push('event_1');
+			ring.push('event_2');
+			ring.push('event_3');
+
+			expect(ring.size).toBe(3);
+			const drained = ring.drainAll();
+			expect(drained).toEqual(['event_1', 'event_2', 'event_3']);
+			expect(ring.size).toBe(0);
+		});
+
+		it('handles buffer overflow by overwriting oldest and tracking droppedCount', () => {
+			const ring = new AsyncRingBuffer<number>(4);
+			ring.push(1);
+			ring.push(2);
+			ring.push(3);
+			ring.push(4);
+			expect(ring.size).toBe(4);
+			expect(ring.droppedCount).toBe(0);
+
+			// Push 5th and 6th items (overwrites 1 and 2)
+			const res5 = ring.push(5);
+			const res6 = ring.push(6);
+			expect(res5).toBe(false); // indicated dropped
+			expect(res6).toBe(false);
+			expect(ring.droppedCount).toBe(2);
+			expect(ring.size).toBe(4);
+
+			const drained = ring.drainAll();
+			expect(drained).toEqual([3, 4, 5, 6]);
+			expect(ring.size).toBe(0);
+		});
+	});
+});
