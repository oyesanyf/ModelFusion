+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+import { Disposable } from '../../util/vs/base/common/lifecycle';
+import { EvolutionStateManager } from './evolutionStateManager';
+
+export const CANDIDATE_SCHEME = 'hugos-candidate';
+
+export class OpenEvolveContentProvider extends Disposable implements vscode.TextDocumentContentProvider {
+	public static readonly scheme = CANDIDATE_SCHEME;
+	private static _instance?: OpenEvolveContentProvider;
+
+	public static getInstance(): OpenEvolveContentProvider | undefined {
+		return OpenEvolveContentProvider._instance;
+	}
+
+	public static setInstance(instance: OpenEvolveContentProvider | undefined): void {
+		OpenEvolveContentProvider._instance = instance;
+	}
+
+	private readonly _onDidChange = this._register(new vscode.EventEmitter<vscode.Uri>());
+	public readonly onDidChange: vscode.Event<vscode.Uri> = this._onDidChange.event;
+
+	constructor(private readonly _stateManager: EvolutionStateManager) {
+		super();
+		OpenEvolveContentProvider._instance = this;
+	}
+
+	/**
+	 * Resolves candidate source code from EvolutionStateManager candidate cache
+	 * for virtual URI `hugos-candidate://candidate/<candidateId>/<relativePath>`
+	 */
+	public provideTextDocumentContent(uri: vscode.Uri, _token?: vscode.CancellationToken): string {
+		let pathStr = uri.path;
+		if (pathStr.startsWith('/')) {
+			pathStr = pathStr.slice(1);
+		}
+
+		if (!pathStr || pathStr.trim() === '') {
+			return '// Error: Missing candidate ID';
+		}
+
+		const parts = pathStr.split('/');
+		const candidateId = parts[0];
+
+		if (!candidateId || candidateId.trim() === '') {
+			return '// Error: Missing candidate ID';
+		}
+
+		// Security boundary: defense against directory traversal
+		if (candidateId.includes('..') || parts.some(p => p === '..')) {
+			const candidate = this._stateManager.getCandidate(candidateId);
+			if (!candidate) {
+				return `// Candidate ${candidateId} not found in active session`;
+			}
+			return candidate.candidateContent ?? '';
+		}
+
+		const candidate = this._stateManager.getCandidate(candidateId);
+		if (!candidate) {
+			return `// Candidate ${candidateId} not found in active session`;
+		}
+
+		return candidate.candidateContent ?? '';
+	}
+
+	/**
+	 * Notifies VS Code document viewers that candidate content has updated
+	 */
+	public notifyCandidateUpdated(candidateId: string, filePath: string = 'target.ts'): void {
+		const fileName = filePath.split(/[/\\]/).pop() || 'target.ts';
+		const uri = vscode.Uri.parse(`${CANDIDATE_SCHEME}://candidate/${candidateId}/${fileName}`);
+		this._onDidChange.fire(uri);
+	}
+
+	override dispose(): void {
+		if (OpenEvolveContentProvider._instance === this) {
+			OpenEvolveContentProvider._instance = undefined;
+		}
+		super.dispose();
+	}
+}
+
+// Alias for backwards compatibility with test harnesses and consumers
+export { OpenEvolveContentProvider as CandidateContentProvider };
