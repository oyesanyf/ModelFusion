+    }
+
+    async applyEdit(edit) {
+        for (const [uriStr, fileEdits] of edit.edits.entries()) {
+            const uri = Uri.parse(uriStr);
+            let current = this.workspaceFiles.get(uri.fsPath) || '';
+            for (const item of fileEdits) {
+                if (!item.range || (item.range.start === 0 && item.range.end >= current.length)) {
+                    current = item.newText;
+                } else {
+                    current = item.newText;
+                }
+            }
+            this.workspaceFiles.set(uri.fsPath, current);
+        }
+        return true;
+    }
+
+    getConfiguration(section) {
+        return {
+            get: (key, defaultValue) => {
+                const fullKey = section ? `${section}.${key}` : key;
+                return this.configuration.has(fullKey) ? this.configuration.get(fullKey) : defaultValue;
+            },
+            update: async (key, value) => {
