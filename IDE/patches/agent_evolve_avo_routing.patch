+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+import { Disposable } from '../../util/vs/base/common/lifecycle';
+import { AgentThoughtLog } from './teamPresetManager';
+
+export type EvolutionRunStatus = 'idle' | 'running' | 'paused' | 'completed' | 'stopped' | 'error';
+export type EvolutionMode = 'openevolve' | 'avo' | 'swarm';
+
+export interface FitnessMetricPoint {
+	generation: number;
+	step: number;
+	timestamp: number;
+	fitness: number;
+	bestFitness: number;
+	tokenCount: number;
+	memoryUsageMb: number;
+	passRate: number;
+	mutationType?: string;
+	candidateId?: string;
+	filePath?: string;
+	candidateContent?: string;
+	originalContent?: string;
+	summary?: string;
+	diffSummary?: string;
+	metrics?: Record<string, number>;
+}
+
+export interface CandidateInfo {
+	candidateId: string;
+	generation: number;
+	fitness: number;
+	parentCandidateId?: string;
+	summary: string;
+	diffSummary: string;
+	filePath: string;
+	originalContent?: string;
+	candidateContent: string;
+	timestamp: number;
+	status: 'evaluated' | 'applied' | 'rejected' | 'pending';
+	metrics?: Record<string, number>;
+}
+
+export interface BackendStatsInfo {
+	connected: boolean;
+	latencyMs: number;
+	memoryUsageMb: number;
+	cpuUsagePercent: number;
+	activeTasks: number;
+	queueDepth: number;
+	mcpServerStatus: 'online' | 'offline' | 'degraded';
+	totalTokensUsed: number;
+	activeRunners: number;
+	lastUpdated: number;
+}
+
+export interface EvolutionRunState {
+	runId: string;
+	status: EvolutionRunStatus;
+	mode: EvolutionMode;
+	targetDir: string;
+	currentIteration: number;
+	maxIterations: number;
+	currentFitness: number;
+	bestFitness: number;
+	startTime: number;
+	endTime?: number;
+	error?: string;
+}
+
+export class EvolutionStateManager extends Disposable {
+	private static _instance?: EvolutionStateManager;
+
+	public static getInstance(): EvolutionStateManager | undefined {
+		return EvolutionStateManager._instance;
+	}
+
+	public static setInstance(instance: EvolutionStateManager | undefined): void {
+		EvolutionStateManager._instance = instance;
+	}
+
+	private _runState: EvolutionRunState = {
+		runId: '',
+		status: 'idle',
+		mode: 'openevolve',
+		targetDir: '',
+		currentIteration: 0,
+		maxIterations: 20,
+		currentFitness: 0,
+		bestFitness: 0,
+		startTime: 0
+	};
+
+	private readonly _metricsHistory: FitnessMetricPoint[] = [];
+	private readonly _candidates = new Map<string, CandidateInfo>();
+	private readonly _thoughts: AgentThoughtLog[] = [];
+	private _backendStats: BackendStatsInfo = {
+		connected: false,
+		latencyMs: 0,
+		memoryUsageMb: 0,
+		cpuUsagePercent: 0,
+		activeTasks: 0,
+		queueDepth: 0,
+		mcpServerStatus: 'offline',
+		totalTokensUsed: 0,
+		activeRunners: 0,
+		lastUpdated: Date.now()
+	};
+
+	private readonly _onDidChangeRunState = this._register(new vscode.EventEmitter<EvolutionRunState>());
+	public readonly onDidChangeRunState: vscode.Event<EvolutionRunState> = this._onDidChangeRunState.event;
+
+	private readonly _onDidAddMetricPoint = this._register(new vscode.EventEmitter<FitnessMetricPoint>());
+	public readonly onDidAddMetricPoint: vscode.Event<FitnessMetricPoint> = this._onDidAddMetricPoint.event;
+
+	private readonly _onDidAddCandidate = this._register(new vscode.EventEmitter<CandidateInfo>());
+	public readonly onDidAddCandidate: vscode.Event<CandidateInfo> = this._onDidAddCandidate.event;
+
+	private readonly _onDidAddThought = this._register(new vscode.EventEmitter<AgentThoughtLog>());
+	public readonly onDidAddThought: vscode.Event<AgentThoughtLog> = this._onDidAddThought.event;
+
+	private readonly _onDidChangeBackendStats = this._register(new vscode.EventEmitter<BackendStatsInfo>());
+	public readonly onDidChangeBackendStats: vscode.Event<BackendStatsInfo> = this._onDidChangeBackendStats.event;
+
+	private readonly _onDidReset = this._register(new vscode.EventEmitter<void>());
+	public readonly onDidReset: vscode.Event<void> = this._onDidReset.event;
+
+	constructor() {
+		super();
+		EvolutionStateManager._instance = this;
+	}
+
+	public getRunState(): EvolutionRunState {
+		return { ...this._runState };
+	}
+
+	public getMetricsHistory(): FitnessMetricPoint[] {
+		return [...this._metricsHistory];
+	}
+
+	public getCandidates(): CandidateInfo[] {
+		return Array.from(this._candidates.values());
+	}
+
+	public getCandidate(candidateId: string): CandidateInfo | undefined {
+		return this._candidates.get(candidateId);
+	}
+
+	public getThoughts(limit?: number): AgentThoughtLog[] {
+		if (limit && limit > 0) {
+			return this._thoughts.slice(-limit);
+		}
+		return [...this._thoughts];
+	}
+
+	public getBackendStats(): BackendStatsInfo {
+		return { ...this._backendStats };
+	}
+
+	public startRun(config: { targetDir?: string; targetFile?: string; iterations?: number; maxIterations?: number; mode?: EvolutionMode; backend?: string; runId?: string }): string {
+		const runId = config.runId || `run_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;
+		const targetDir = config.targetDir || config.targetFile || 'src/';
+		const iterations = config.iterations ?? config.maxIterations ?? 20;
+		const mode: EvolutionMode = config.mode || 'openevolve';
+
+		this._runState = {
+			runId,
+			status: 'running',
+			mode,
+			targetDir,
+			currentIteration: 0,
+			maxIterations: Math.max(1, iterations),
+			currentFitness: 0,
+			bestFitness: 0,
+			startTime: Date.now()
+		};
+
+		this.addThought({
+			agentId: 'system',
+			role: 'system',
+			thought: `Started ${mode.toUpperCase()} evolutionary run [${runId}] targeting "${targetDir}" for ${iterations} iterations.`,
+			state: 'running',
+			level: 'dispatch'
+		});
+
+		this._onDidChangeRunState.fire(this.getRunState());
+		return runId;
+	}
+
+	/**
+	 * Contract alias for startRun
+	 */
+	public launch(runConfig: { targetFile?: string; targetDir?: string; iterations?: number; maxIterations?: number; mode?: EvolutionMode; backend?: string; runId?: string }): string {
+		return this.startRun(runConfig);
+	}
+
+	public pauseRun(): void {
+		if (this._runState.status === 'running') {
+			this._runState.status = 'paused';
+			this.addThought({
+				agentId: 'system',
+				role: 'system',
+				thought: `Evolutionary run [${this._runState.runId}] paused at generation ${this._runState.currentIteration}.`,
+				state: 'paused',
+				level: 'info'
+			});
+			this._onDidChangeRunState.fire(this.getRunState());
+		}
+	}
+
+	/**
+	 * Contract alias for pauseRun
+	 */
+	public pause(): void {
+		this.pauseRun();
+	}
+
+	public resumeRun(): void {
+		if (this._runState.status === 'paused') {
+			this._runState.status = 'running';
+			this.addThought({
+				agentId: 'system',
+				role: 'system',
+				thought: `Evolutionary run [${this._runState.runId}] resumed.`,
+				state: 'running',
+				level: 'info'
+			});
+			this._onDidChangeRunState.fire(this.getRunState());
+		}
+	}
+
+	/**
+	 * Contract alias for resumeRun
+	 */
+	public resume(): void {
+		this.resumeRun();
+	}
+
+	public stopRun(): void {
+		if (this._runState.status === 'running' || this._runState.status === 'paused') {
+			this._runState.status = 'stopped';
+			this._runState.endTime = Date.now();
+			this.addThought({
+				agentId: 'system',
+				role: 'system',
+				thought: `Evolutionary run [${this._runState.runId}] stopped. Best Fitness: ${(this._runState.bestFitness * 100).toFixed(1)}%`,
+				state: 'stopped',
+				level: 'warn'
+			});
+			this._onDidChangeRunState.fire(this.getRunState());
+		}
+	}
+
+	/**
+	 * Contract alias for stopRun
+	 */
+	public stop(): void {
+		this.stopRun();
+	}
+
+	public completeRun(): void {
+		if (this._runState.status === 'running' || this._runState.status === 'paused') {
+			this._runState.status = 'completed';
+			this._runState.endTime = Date.now();
+			this.addThought({
+				agentId: 'system',
+				role: 'system',
+				thought: `Evolutionary run [${this._runState.runId}] completed successfully! Best Fitness: ${(this._runState.bestFitness * 100).toFixed(1)}%`,
+				state: 'completed',
+				level: 'info'
+			});
+			this._onDidChangeRunState.fire(this.getRunState());
+		}
+	}
+
+	public recordStep(point: Partial<FitnessMetricPoint> & { fitness: number; bestFitness?: number }): FitnessMetricPoint {
+		const generation = point.generation ?? this._runState.currentIteration + 1;
+		const step = point.step ?? this._metricsHistory.length + 1;
+
+		const rawFitness = point.fitness;
+		const sanitizedFitness = Number.isFinite(rawFitness) ? rawFitness : 0.0;
+		const rawBestFitness = point.bestFitness ?? sanitizedFitness;
+		const sanitizedBestFitness = Number.isFinite(rawBestFitness) ? rawBestFitness : 0.0;
+		const bestFitness = Math.max(sanitizedBestFitness, this._runState.bestFitness);
+
+		const rawTokenCount = point.tokenCount ?? (this._metricsHistory.length > 0 ? this._metricsHistory[this._metricsHistory.length - 1].tokenCount + 450 : 450);
+		const tokenCount = Math.max(0, Number.isFinite(rawTokenCount) ? rawTokenCount : 0);
+
+		const fullPoint: FitnessMetricPoint = {
+			generation,
+			step,
+			timestamp: point.timestamp ?? Date.now(),
+			fitness: sanitizedFitness,
+			bestFitness,
+			tokenCount,
+			memoryUsageMb: point.memoryUsageMb ?? 142.5,
+			passRate: point.passRate ?? Math.min(1.0, sanitizedFitness * 1.1),
+			mutationType: point.mutationType,
+			candidateId: point.candidateId,
+			filePath: point.filePath,
+			candidateContent: point.candidateContent,
+			originalContent: point.originalContent,
+			summary: point.summary,
+			diffSummary: point.diffSummary,
+			metrics: point.metrics
+		};
+
+		if (point.candidateId) {
+			this.addCandidate({
+				candidateId: point.candidateId,
+				generation,
+				fitness: sanitizedFitness,
+				parentCandidateId: (point as any).parentCandidateId,
+				summary: point.summary || `Candidate ${point.candidateId}`,
+				diffSummary: point.diffSummary || '',
+				filePath: point.filePath || '',
+				originalContent: point.originalContent,
+				candidateContent: point.candidateContent ?? '',
+				timestamp: point.timestamp ?? Date.now(),
+				status: 'evaluated',
+				metrics: point.metrics
+			});
+		}
+
+		this._metricsHistory.push(fullPoint);
+		if (this._metricsHistory.length > 5000) {
+			this._metricsHistory.shift();
+		}
+
+		this._runState.currentIteration = generation;
+		this._runState.currentFitness = sanitizedFitness;
+		this._runState.bestFitness = bestFitness;
+
+		if (this._runState.currentIteration >= this._runState.maxIterations && this._runState.status === 'running') {
+			this.completeRun();
+		} else {
+			this._onDidChangeRunState.fire(this.getRunState());
+		}
+
+		this._onDidAddMetricPoint.fire(fullPoint);
+		return fullPoint;
+	}
+
+	public addCandidate(candidate: CandidateInfo): void {
+		this._candidates.set(candidate.candidateId, candidate);
+		this._onDidAddCandidate.fire(candidate);
+	}
+
+	public updateCandidateStatus(candidateId: string, status: CandidateInfo['status']): void {
+		const candidate = this._candidates.get(candidateId);
+		if (candidate) {
+			candidate.status = status;
+			this._onDidAddCandidate.fire({ ...candidate });
+		}
+	}
+
+	public addThought(thought: Omit<AgentThoughtLog, 'id' | 'timestamp'> & { timestamp?: number }): AgentThoughtLog {
+		const rawTimestamp = thought.timestamp ?? Date.now();
+		const timestamp = rawTimestamp < 0 ? Date.now() : rawTimestamp;
+		const sanitizedThought = (thought.thought || '').replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g, '');
+
+		const fullThought: AgentThoughtLog = {
+			id: `thought_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,
+			timestamp,
+			...thought,
+			thought: sanitizedThought
+		};
+
+		this._thoughts.push(fullThought);
+		if (this._thoughts.length > 1000) {
+			this._thoughts.shift();
+		}
+
+		this._onDidAddThought.fire(fullThought);
+		return fullThought;
+	}
+
+	/**
+	 * Contract alias for recording agent thoughts
+	 */
+	public recordThought(agentId: string, role: string, thought: string, state: string = 'thinking'): AgentThoughtLog {
+		return this.addThought({
+			agentId,
+			role,
+			thought,
+			state,
+			level: 'thought'
+		});
+	}
+
+	public updateBackendStats(stats: Partial<BackendStatsInfo>): void {
+		this._backendStats = {
+			...this._backendStats,
+			...stats,
+			lastUpdated: Date.now()
+		};
+		this._onDidChangeBackendStats.fire(this.getBackendStats());
+	}
+
+	public resetState(): void {
+		this._runState = {
+			runId: '',
+			status: 'idle',
+			mode: 'openevolve',
+			targetDir: '',
+			currentIteration: 0,
+			maxIterations: 20,
+			currentFitness: 0,
+			bestFitness: 0,
+			startTime: 0
+		};
+		this._metricsHistory.length = 0;
+		this._candidates.clear();
+		this._thoughts.length = 0;
+
+		this.addThought({
+			agentId: 'system',
+			role: 'system',
+			thought: 'Evolution state reset to clean baseline.',
+			state: 'idle',
+			level: 'info'
+		});
+
+		this._onDidReset.fire();
+		this._onDidChangeRunState.fire(this.getRunState());
+	}
+
+	public getSnapshot(): Record<string, unknown> {
+		return {
+			runState: this.getRunState(),
+			metricsHistory: this.getMetricsHistory(),
+			candidates: this.getCandidates(),
+			thoughts: this.getThoughts(200),
+			backendStats: this.getBackendStats()
+		};
+	}
+
+	override dispose(): void {
+		if (EvolutionStateManager._instance === this) {
+			EvolutionStateManager._instance = undefined;
+		}
+		super.dispose();
+	}
+}
