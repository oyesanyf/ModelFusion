@@ -0,0 +1,399 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import * as vscode from 'vscode';
+import * as http from 'http';
+import { Disposable, IDisposable, toDisposable } from '../../util/vs/base/common/lifecycle';
+import { ILogService } from '../../platform/log/common/logService';
+import { EvolutionStateManager } from './evolutionStateManager';
+import { TeamPresetManager } from './teamPresetManager';
+
+export interface DashboardEvent {
+	id: string;
+	type: string;
+	timestamp: number;
+	payload: unknown;
+}
+
+export interface EventStreamTelemetry {
+	fps: number;
+	totalEventsEnqueued: number;
+	totalEventsDispatched: number;
+	droppedEventsCount: number;
+	bufferCapacity: number;
+	currentBufferSize: number;
+	lastBatchSize: number;
+	lastBatchLatencyMs: number;
+}
+
+export class AsyncRingBuffer<T> {
+	private readonly _buffer: (T | undefined)[];
+	private readonly _capacity: number;
+	private _head = 0;
+	private _tail = 0;
+	private _count = 0;
+	private _droppedCount = 0;
+
+	constructor(capacity: number = 4096) {
+		this._capacity = Math.max(1, capacity);
+		this._buffer = new Array(this._capacity);
+	}
+
+	public get capacity(): number {
+		return this._capacity;
+	}
+
+	public get size(): number {
+		return this._count;
+	}
+
+	public get droppedCount(): number {
+		return this._droppedCount;
+	}
+
+	public push(item: T): boolean {
+		let dropped = false;
+		if (this._count === this._capacity) {
+			// Buffer full: advance head to overwrite oldest
+			this._head = (this._head + 1) % this._capacity;
+			this._count--;
+			this._droppedCount++;
+			dropped = true;
+		}
+
+		this._buffer[this._tail] = item;
+		this._tail = (this._tail + 1) % this._capacity;
+		this._count++;
+		return !dropped;
+	}
+
+	public drainAll(): T[] {
+		if (this._count === 0) {
+			return [];
+		}
+
+		const items: T[] = new Array(this._count);
+		for (let i = 0; i < this._count; i++) {
+			const index = (this._head + i) % this._capacity;
+			items[i] = this._buffer[index]!;
+			this._buffer[index] = undefined;
+		}
+
+		this._head = 0;
+		this._tail = 0;
+		this._count = 0;
+		return items;
+	}
+
+	public clear(): void {
+		this._buffer.fill(undefined);
+		this._head = 0;
+		this._tail = 0;
+		this._count = 0;
+	}
+}
+
+export class EventStreamService extends Disposable {
+	private static _instance?: EventStreamService;
+
+	public static getInstance(): EventStreamService | undefined {
+		return EventStreamService._instance;
+	}
+
+	public static setInstance(instance: EventStreamService | undefined): void {
+		EventStreamService._instance = instance;
+	}
+
+	private readonly _ringBuffer = new AsyncRingBuffer<DashboardEvent>(4096);
+	private readonly _webviews = new Set<vscode.Webview>();
+
+	private _dispatchTimer?: NodeJS.Timeout;
+	private _pollTimer?: NodeJS.Timeout;
+	private _isRunning = false;
+
+	// Telemetry metrics
+	private _totalEnqueued = 0;
+	private _totalDispatched = 0;
+	private _lastBatchSize = 0;
+	private _lastBatchLatencyMs = 0;
+	private _frameCount = 0;
+	private _currentFps = 60;
+	private _lastFpsCalcTime = Date.now();
+
+	private readonly _onBatchDispatched = this._register(new vscode.EventEmitter<DashboardEvent[]>());
+	public readonly onBatchDispatched: vscode.Event<DashboardEvent[]> = this._onBatchDispatched.event;
+
+	constructor(
+		private readonly _stateManager: EvolutionStateManager,
+		private readonly _presetManager: TeamPresetManager,
+		@ILogService private readonly _logService: ILogService
+	) {
+		super();
+		EventStreamService._instance = this;
+		this._hookStateEvents();
+	}
+
+	private _hookStateEvents(): void {
+		this._register(this._stateManager.onDidChangeRunState(state => {
+			this.enqueue({
+				id: `evt_run_${Date.now()}`,
+				type: 'evolutionState',
+				timestamp: Date.now(),
+				payload: state
+			});
+		}));
+
+		this._register(this._stateManager.onDidAddMetricPoint(point => {
+			this.enqueue({
+				id: `evt_metric_${point.step}_${point.generation}`,
+				type: 'evolutionStep',
+				timestamp: point.timestamp,
+				payload: point
+			});
+		}));
+
+		this._register(this._stateManager.onDidAddThought(thought => {
+			this.enqueue({
+				id: `evt_thought_${thought.id}`,
+				type: 'agentThoughtStream',
+				timestamp: thought.timestamp,
+				payload: thought
+			});
+		}));
+
+		this._register(this._stateManager.onDidAddCandidate(candidate => {
+			this.enqueue({
+				id: `evt_candidate_${candidate.candidateId}`,
+				type: 'candidateUpdate',
+				timestamp: candidate.timestamp,
+				payload: candidate
+			});
+		}));
+
+		this._register(this._stateManager.onDidChangeBackendStats(stats => {
+			this.enqueue({
+				id: `evt_stats_${Date.now()}`,
+				type: 'backendStats',
+				timestamp: stats.lastUpdated,
+				payload: stats
+			});
+		}));
+
+		this._register(this._presetManager.onPresetChanged(preset => {
+			this.enqueue({
+				id: `evt_preset_${Date.now()}`,
+				type: 'teamPresetChanged',
+				timestamp: Date.now(),
+				payload: preset
+			});
+		}));
+
+		this._register(this._presetManager.onAgentsUpdated(agents => {
+			this.enqueue({
+				id: `evt_agents_${Date.now()}`,
+				type: 'teamStateUpdate',
+				timestamp: Date.now(),
+				payload: {
+					agents,
+					activePreset: this._presetManager.getActivePreset().id
+				}
+			});
+		}));
+
+		this._register(this._stateManager.onDidReset(() => {
+			this.enqueue({
+				id: `evt_reset_${Date.now()}`,
+				type: 'stateReset',
+				timestamp: Date.now(),
+				payload: { timestamp: Date.now() }
+			});
+		}));
+	}
+
+	public enqueue(event: DashboardEvent): void {
+		this._ringBuffer.push(event);
+		this._totalEnqueued++;
+	}
+
+	public registerWebview(webview: vscode.Webview): IDisposable {
+		this._webviews.add(webview);
+
+		// Send initial full state snapshot
+		const initialPayload = {
+			type: 'fullStateSnapshot',
+			timestamp: Date.now(),
+			payload: {
+				...this._stateManager.getSnapshot(),
+				activePreset: this._presetManager.getActivePreset(),
+				presets: this._presetManager.getPresets(),
+				agents: this._presetManager.getAgents(),
+				telemetry: this.getTelemetry()
+			}
+		};
+
+		try {
+			webview.postMessage(initialPayload);
+		} catch (err: unknown) {
+			this._logService.error(`EventStreamService: Failed to send initial state to webview: ${err}`);
+		}
+
+		return toDisposable(() => {
+			this._webviews.delete(webview);
+		});
+	}
+
+	public start(): void {
+		if (this._isRunning) {
+			return;
+		}
+		this._isRunning = true;
+
+		// 60fps frame dispatcher (approx. 16.6ms loop)
+		this._dispatchTimer = setInterval(() => {
+			this._dispatchFrame();
+		}, 16);
+
+		// 1500ms backend polling loop
+		this._pollTimer = setInterval(() => {
+			this._pollBackendStats();
+		}, 1500);
+
+		this._pollBackendStats();
+		this._logService.info('EventStreamService: 60fps Ring Buffer & Dispatch Engine started.');
+	}
+
+	public stop(): void {
+		if (!this._isRunning) {
+			return;
+		}
+		this._isRunning = false;
+
+		if (this._dispatchTimer) {
+			clearInterval(this._dispatchTimer);
+			this._dispatchTimer = undefined;
+		}
+
+		if (this._pollTimer) {
+			clearInterval(this._pollTimer);
+			this._pollTimer = undefined;
+		}
+	}
+
+	private _dispatchFrame(): void {
+		this._frameCount++;
+		const now = Date.now();
+		if (now - this._lastFpsCalcTime >= 1000) {
+			this._currentFps = Math.round((this._frameCount * 1000) / (now - this._lastFpsCalcTime));
+			this._frameCount = 0;
+			this._lastFpsCalcTime = now;
+		}
+
+		const events = this._ringBuffer.drainAll();
+		if (events.length === 0) {
+			return;
+		}
+
+		const startDispatch = Date.now();
+		this._lastBatchSize = events.length;
+		this._totalDispatched += events.length;
+
+		const batchMessage = {
+			type: 'batchEvents',
+			timestamp: now,
+			fps: this._currentFps,
+			events
+		};
+
+		for (const webview of this._webviews) {
+			try {
+				webview.postMessage(batchMessage);
+			} catch (err: unknown) {
+				this._logService.error(`EventStreamService: Failed to post batch message: ${err}`);
+			}
+		}
+
+		this._lastBatchLatencyMs = Date.now() - startDispatch;
+		this._onBatchDispatched.fire(events);
+	}
+
+	private _pollBackendStats(): void {
+		const reqStart = Date.now();
+		const req = http.get('http://127.0.0.1:5000/stats', { timeout: 800 }, res => {
+			let data = '';
+			res.on('data', chunk => {
+				data += chunk;
+			});
+			res.on('end', () => {
+				const latency = Date.now() - reqStart;
+				if (res.statusCode === 200) {
+					try {
+						const parsed = JSON.parse(data);
+						this._stateManager.updateBackendStats({
+							connected: true,
+							latencyMs: latency,
+							memoryUsageMb: parsed.memory_mb ?? parsed.memoryUsageMb ?? 85.4,
+							cpuUsagePercent: parsed.cpu_percent ?? parsed.cpuUsagePercent ?? 12.0,
+							activeTasks: parsed.active_tasks ?? parsed.activeTasks ?? 0,
+							queueDepth: parsed.queue_depth ?? parsed.queueDepth ?? 0,
+							mcpServerStatus: 'online',
+							totalTokensUsed: parsed.total_tokens ?? parsed.totalTokensUsed ?? 0,
+							activeRunners: parsed.active_runners ?? parsed.activeRunners ?? 1
+						});
+					} catch {
+						this._stateManager.updateBackendStats({
+							connected: true,
+							latencyMs: latency,
+							mcpServerStatus: 'online'
+						});
+					}
+				} else {
+					this._stateManager.updateBackendStats({
+						connected: false,
+						latencyMs: latency,
+						mcpServerStatus: 'degraded'
+					});
+				}
+			});
+		});
+
+		req.on('error', () => {
+			// Backend offline - record non-blocking disconnected state
+			this._stateManager.updateBackendStats({
+				connected: false,
+				latencyMs: 0,
+				mcpServerStatus: 'offline'
+			});
+		});
+
+		req.on('timeout', () => {
+			req.destroy();
+			this._stateManager.updateBackendStats({
+				connected: false,
+				latencyMs: 800,
+				mcpServerStatus: 'degraded'
+			});
+		});
+	}
+
+	public getTelemetry(): EventStreamTelemetry {
+		return {
+			fps: this._currentFps,
+			totalEventsEnqueued: this._totalEnqueued,
+			totalEventsDispatched: this._totalDispatched,
+			droppedEventsCount: this._ringBuffer.droppedCount,
+			bufferCapacity: this._ringBuffer.capacity,
+			currentBufferSize: this._ringBuffer.size,
+			lastBatchSize: this._lastBatchSize,
+			lastBatchLatencyMs: this._lastBatchLatencyMs
+		};
+	}
+
+	override dispose(): void {
+		this.stop();
+		this._ringBuffer.clear();
+		this._webviews.clear();
+		super.dispose();
+	}
+}
