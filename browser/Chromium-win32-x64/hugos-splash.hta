<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>Starting HugOS Browser...</title>
<HTA:APPLICATION
  ID="HugOSBrowserSplash"
  APPLICATIONNAME="HugOS Browser"
  BORDER="none"
  BORDERSTYLE="normal"
  CAPTION="no"
  SHOWINTASKBAR="no"
  SINGLEINSTANCE="yes"
  SYSMENU="no"
  SCROLL="no"
  CONTEXTMENU="no"
  SELECTION="no"
  WINDOWSTATE="normal"
/>
<script type="text/javascript">
  try {
    var w = 440, h = 250;
    window.resizeTo(w, h);
    window.moveTo(Math.floor((screen.availWidth - w) / 2), Math.floor((screen.availHeight - h) / 2));
    window.focus();
  } catch (e) {}
  setTimeout(function() {
    try { window.close(); } catch (e) {}
  }, 3200);
</script>
<style type="text/css">
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #0d1117;
    color: #f0f6fc;
    font-family: "Segoe UI", Tahoma, sans-serif;
  }
  .card {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 25%, #261019 0%, #0d1117 75%);
    border: 2px solid #ff4b72;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 36px 24px;
  }
  .badge {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 3px solid #ff4b72;
    background: #1a0b12;
    color: #ff4b72;
    font-size: 24px;
    font-weight: 800;
    line-height: 50px;
    margin: 0 auto 16px auto;
    box-shadow: 0 0 20px rgba(255, 75, 114, 0.45);
  }
  h1 {
    font-size: 21px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
  }
  p {
    font-size: 12.5px;
    color: #8b949e;
    margin-bottom: 20px;
  }
  .bar-bg {
    width: 280px;
    height: 6px;
    background: #21262d;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
  }
  .bar-fill {
    width: 110px;
    height: 6px;
    background: #ff4b72;
    position: absolute;
    left: 0;
    top: 0;
  }
</style>
</head>
<body>
  <div class="card">
    <div class="badge">H</div>
    <h1>HugOS Browser</h1>
    <p id="statusText">Launching ModelFusion AI Web Environment...</p>
    <div class="bar-bg">
      <div class="bar-fill" id="barFill"></div>
    </div>
  </div>
  <script type="text/javascript">
    var pos = -110;
    var fill = document.getElementById("barFill");
    setInterval(function() {
      pos += 14;
      if (pos > 280) pos = -110;
      if (fill) fill.style.left = pos + "px";
    }, 30);
  </script>
</body>
</html>
