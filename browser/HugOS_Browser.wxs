<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="HugOS Browser" Manufacturer="HugOS Team" Version="1.0.72" UpgradeCode="e98c7d08-91cb-4248-bfa5-765c96ddeca6" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="HugOSBrowserIcon.ico" SourceFile="D:\harfile\ModelFusion\IDE\hugos_browser.ico" />
    <Property Id="ARPPRODUCTICON" Value="HugOSBrowserIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/oyesanyf/ModelFusion" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/oyesanyf/ModelFusion" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="HugOS Browser">
        <Directory Id="dir_1" Name="bin">
          <Directory Id="dir_2" Name="db">
          </Directory>
        </Directory>
        <Directory Id="dir_3" Name="Chromium-win32-x64">
        </Directory>
        <Directory Id="dir_4" Name="config">
        </Directory>
        <Directory Id="dir_5" Name="db">
        </Directory>
        <Directory Id="dir_6" Name="dist">
          <Directory Id="dir_7" Name="win-unpacked">
            <Directory Id="dir_8" Name="resources">
              <Directory Id="dir_9" Name="bin">
              </Directory>
            </Directory>
          </Directory>
        </Directory>
        <Directory Id="dir_10" Name="extension">
        </Directory>
        <Directory Id="dir_11" Name="ui">
        </Directory>

      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="HugOS Browser" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="ApplicationShortcutDesktop" Guid="*">
        <Shortcut Id="ApplicationDesktopShortcut" Name="HugOS Browser" Target="[SystemFolder]wscript.exe" Arguments="&quot;[INSTALLFOLDER]Chromium-win32-x64\hugos-browser.vbs&quot;" WorkingDirectory="INSTALLFOLDER" Icon="HugOSBrowserIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\HugOSTeam\HugOSBrowser" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="HugOS Browser" Target="[SystemFolder]wscript.exe" Arguments="&quot;[INSTALLFOLDER]Chromium-win32-x64\hugos-browser.vbs&quot;" Directory="ApplicationProgramsFolder" WorkingDirectory="INSTALLFOLDER" Icon="HugOSBrowserIcon.ico" />
        <RemoveFolder Id="CleanUpShortcuts" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\HugOSTeam\HugOSBrowser" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main">
      <ComponentGroupRef Id="BrowserFilesComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>

    <ComponentGroup Id="BrowserFilesComponents">
      <Component Id="cmp_1" Guid="*" Directory="dir_1">
        <File Id="fil_1" Source="bin\cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_2" Guid="*" Directory="dir_1">
        <File Id="fil_2" Source="bin\clibrowser.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_3" Guid="*" Directory="dir_2">
        <File Id="fil_3" Source="bin\db\hf_models.db" KeyPath="yes" />
      </Component>
      <Component Id="cmp_4" Guid="*" Directory="dir_1">
        <File Id="fil_4" Source="bin\ffmpeg.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_5" Guid="*" Directory="INSTALLFOLDER">
        <File Id="fil_5" Source="build_browser.ps1" KeyPath="yes" />
      </Component>
      <Component Id="cmp_6" Guid="*" Directory="INSTALLFOLDER">
        <File Id="fil_6" Source="build_number.txt" KeyPath="yes" />
      </Component>
      <Component Id="cmp_7" Guid="*" Directory="dir_3">
        <File Id="fil_7" Source="Chromium-win32-x64\hugos-browser.bat" KeyPath="yes" />
      </Component>
      <Component Id="cmp_8" Guid="*" Directory="dir_3">
        <File Id="fil_8" Source="Chromium-win32-x64\hugos-browser.vbs" KeyPath="yes" />
      </Component>
      <Component Id="cmp_9" Guid="*" Directory="dir_3">
        <File Id="fil_9" Source="Chromium-win32-x64\hugos_browser.ico" KeyPath="yes" />
      </Component>
      <Component Id="cmp_10" Guid="*" Directory="dir_3">
        <File Id="fil_10" Source="Chromium-win32-x64\run_hidden.vbs" KeyPath="yes" />
      </Component>
      <Component Id="cmp_11" Guid="*" Directory="dir_4">
        <File Id="fil_11" Source="config\default_preferences.json" KeyPath="yes" />
      </Component>
      <Component Id="cmp_12" Guid="*" Directory="dir_5">
        <File Id="fil_12" Source="db\hf_models.db" KeyPath="yes" />
      </Component>
      <Component Id="cmp_13" Guid="*" Directory="dir_9">
        <File Id="fil_13" Source="dist\win-unpacked\resources\bin\cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_14" Guid="*" Directory="dir_9">
        <File Id="fil_14" Source="dist\win-unpacked\resources\bin\clibrowser.exe" KeyPath="yes" />
      </Component>
      <Component Id="cmp_15" Guid="*" Directory="dir_10">
        <File Id="fil_15" Source="extension\background.js" KeyPath="yes" />
      </Component>
      <Component Id="cmp_16" Guid="*" Directory="dir_10">
        <File Id="fil_16" Source="extension\content.js" KeyPath="yes" />
      </Component>
      <Component Id="cmp_17" Guid="*" Directory="dir_10">
        <File Id="fil_17" Source="extension\manifest.json" KeyPath="yes" />
      </Component>
      <Component Id="cmp_18" Guid="*" Directory="dir_10">
        <File Id="fil_18" Source="extension\sidepanel.html" KeyPath="yes" />
      </Component>
      <Component Id="cmp_19" Guid="*" Directory="dir_10">
        <File Id="fil_19" Source="extension\sidepanel.js" KeyPath="yes" />
      </Component>
      <Component Id="cmp_20" Guid="*" Directory="dir_10">
        <File Id="fil_20" Source="extension\styles.css" KeyPath="yes" />
      </Component>
      <Component Id="cmp_21" Guid="*" Directory="INSTALLFOLDER">
        <File Id="fil_21" Source="generate_wix.js" KeyPath="yes" />
      </Component>
      <Component Id="cmp_22" Guid="*" Directory="INSTALLFOLDER">
        <File Id="fil_22" Source="README.md" KeyPath="yes" />
      </Component>
      <Component Id="cmp_23" Guid="*" Directory="dir_11">
        <File Id="fil_23" Source="ui\app.js" KeyPath="yes" />
      </Component>
      <Component Id="cmp_24" Guid="*" Directory="dir_11">
        <File Id="fil_24" Source="ui\favicon-16x16.png" KeyPath="yes" />
      </Component>
      <Component Id="cmp_25" Guid="*" Directory="dir_11">
        <File Id="fil_25" Source="ui\favicon-32x32.png" KeyPath="yes" />
      </Component>
      <Component Id="cmp_26" Guid="*" Directory="dir_11">
        <File Id="fil_26" Source="ui\favicon.ico" KeyPath="yes" />
      </Component>
      <Component Id="cmp_27" Guid="*" Directory="dir_11">
        <File Id="fil_27" Source="ui\favicon.svg" KeyPath="yes" />
      </Component>
      <Component Id="cmp_28" Guid="*" Directory="dir_11">
        <File Id="fil_28" Source="ui\hugos_browser.ico" KeyPath="yes" />
      </Component>
      <Component Id="cmp_29" Guid="*" Directory="dir_11">
        <File Id="fil_29" Source="ui\icon-192.png" KeyPath="yes" />
      </Component>
      <Component Id="cmp_30" Guid="*" Directory="dir_11">
        <File Id="fil_30" Source="ui\icon-512.png" KeyPath="yes" />
      </Component>
      <Component Id="cmp_31" Guid="*" Directory="dir_11">
        <File Id="fil_31" Source="ui\index.html" KeyPath="yes" />
      </Component>
      <Component Id="cmp_32" Guid="*" Directory="dir_11">
        <File Id="fil_32" Source="ui\manifest.webmanifest" KeyPath="yes" />
      </Component>
      <Component Id="cmp_33" Guid="*" Directory="dir_11">
        <File Id="fil_33" Source="ui\stress_test_virtualizer.html" KeyPath="yes" />
      </Component>
      <Component Id="cmp_34" Guid="*" Directory="dir_11">
        <File Id="fil_34" Source="ui\styles.css" KeyPath="yes" />
      </Component>
      <Component Id="cmp_35" Guid="*" Directory="dir_11">
        <File Id="fil_35" Source="ui\sw.js" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
