{
  "manifest_version": 3,
  "name": "HugOS Intelligent Browser Assistant",
  "version": "1.0.0",
  "description": "Autonomous multi-modal web assistant, Set-of-Mark DOM pruner, and ACDSO table extractor for HugOS.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "debugger",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open HugOS AI Assistant"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
